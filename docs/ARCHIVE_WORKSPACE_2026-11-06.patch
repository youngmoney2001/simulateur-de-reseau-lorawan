+// Masque du bloc 0 (bits 0 à 15) et réciproque.
+LoopChannelSet set_from_block0(std::uint16_t bits) {
+    LoopChannelSet s;
+    for (std::size_t i = 0; i < 16U; ++i) {
+        if (((bits >> i) & 1U) != 0) s.set(i);
+    }
+    return s;
