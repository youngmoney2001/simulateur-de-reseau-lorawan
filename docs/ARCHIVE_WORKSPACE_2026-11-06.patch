+        self.assertFalse(ok.flag)
+        with self.assertRaisesRegex(ValidationError, "status == 0x07"):
+            c.TraceEventV3(**trace(kind="link_adr_ans", origin="normative", status=5, flag=True))
+        with self.assertRaisesRegex(ValidationError, "status == 0x07"):
