+                    }
+                }
+                const std::size_t mo = mac_off[i] + ds.next_k;
+                const std::uint32_t bytes = d.payload_bytes + answer_octets(ds.answer_mask) + mac_extra[mo];
+                if (bytes > 255) {
+                    status = SimStatus::InvalidInput;
+                    break;
+                }
