+// Divergence documentée (validation v3, 6.2.2) : le moteur ne valide pas les bits de `dr_mask` de
+// l'état initial. Un bit pour un DR sans entrée `dr_sf` (ici DR6 : la région n'a que DR0..DR5) est
+// accepté ; le DR n'est alors jamais proposé par LinkADRReq (refus UnknownDr, test_loop_adr).
+void test_engine_accepts_dr_mask_bit_without_region_entry() {
+    LoopChannelConfig cfg = cfg_default();
+    cfg.device.dr_mask[0] = 0x41;   // DR0 et DR6 ; region() : dr_sf[6] = 0, max_dr = 5
+    LoopChannelIo io;
+    LoopResult res;
+    SimulationStats tot;
+    DeviceStats st[1];
+    CHECK_EQ(static_cast<int>(run_channels(&cfg, 1, io, res, tot, st, 20)), 0);
+    CHECK_EQ(static_cast<int>(res.uplinks.size()), 20);
+}
