+// Vérifie, pour chaque événement, les sentinelles et les drapeaux attendus de son type.
+void check_trace_fields_by_kind(const LoopResult& res, const std::vector<LoopTraceEvent>& trace) {
+    std::int64_t prev = 0;
+    for (const LoopTraceEvent& e : trace) {
+        CHECK_TRUE(e.t_ns >= prev);
+        prev = e.t_ns;
+        if (e.kind != LoopTraceKind::Downlink) CHECK_EQ(static_cast<int>(e.loss), 0);
+        switch (e.kind) {
+        case LoopTraceKind::Uplink:
+            CHECK_TRUE(e.uplink < res.uplinks.size());
+            CHECK_TRUE(res.uplinks[e.uplink].outcome == TxOutcome::Received);
+            CHECK_TRUE(e.downlink == kLoopNoIndex);
+            CHECK_EQ(static_cast<int>(e.status), 0xFF);
+            CHECK_TRUE(e.origin == LoopTraceOrigin::Radio);
+            CHECK_TRUE(e.flag);
+            break;
+        case LoopTraceKind::LinkAdrAns:
+            CHECK_TRUE(e.uplink < res.uplinks.size());
+            CHECK_TRUE((res.uplinks[e.uplink].answer_mask & 1U) != 0);
+            CHECK_TRUE(e.downlink == kLoopNoIndex);
+            CHECK_TRUE(e.status <= 0x07);
+            CHECK_TRUE(e.origin == LoopTraceOrigin::Normative);
+            break;
+        case LoopTraceKind::Exclusion:
+            CHECK_TRUE(e.downlink == kLoopNoIndex);
+            CHECK_EQ(static_cast<int>(e.status), 0xFF);
+            CHECK_TRUE(e.origin == LoopTraceOrigin::SimulatorPolicy);
+            CHECK_TRUE(e.action == LoopTraceAction::Created || e.action == LoopTraceAction::Renewed ||
+                       e.action == LoopTraceAction::Expired);
+            if (e.target == LoopExclusionTarget::Channel) CHECK_TRUE(e.value < 16);
+            if (e.target == LoopExclusionTarget::Power) CHECK_TRUE(e.value <= 7);
+            if (e.target == LoopExclusionTarget::DataRate) CHECK_TRUE(e.value <= 5);
+            break;
+        case LoopTraceKind::AdrDecision:
+            CHECK_TRUE(e.uplink < res.uplinks.size());
+            CHECK_TRUE(e.downlink == kLoopNoIndex);
+            CHECK_EQ(static_cast<int>(e.status), 0xFF);
+            CHECK_TRUE(e.origin == LoopTraceOrigin::SimulatorPolicy);
+            break;
+        case LoopTraceKind::LinkAdrReq:
+            CHECK_TRUE(e.downlink < res.downlinks.size());
+            if (e.downlink < res.downlinks.size()) {
+                const LoopDownlink& d = res.downlinks[e.downlink];
+                CHECK_TRUE((d.commands & kLoopCmdLinkAdr) != 0);
+                CHECK_EQ(static_cast<int>(e.uplink), static_cast<int>(d.uplink));
+                CHECK_EQ(static_cast<int>(e.dr), static_cast<int>(d.req_dr));
+                CHECK_EQ(static_cast<int>(e.power_index), static_cast<int>(d.req_power_index));
+            }
+            CHECK_EQ(static_cast<int>(e.status), 0xFF);
+            CHECK_TRUE(e.origin == LoopTraceOrigin::SimulatorPolicy);
+            break;
+        case LoopTraceKind::Downlink:
+            CHECK_TRUE(e.downlink < res.downlinks.size());
+            if (e.downlink >= res.downlinks.size()) break;
+            {
+                const LoopDownlink& d = res.downlinks[e.downlink];
+                CHECK_EQ(static_cast<int>(e.uplink), static_cast<int>(d.uplink));
+                CHECK_EQ(static_cast<int>(e.value), static_cast<int>(d.commands));
+                CHECK_TRUE(e.flag == d.delivered);
+                CHECK_EQ(static_cast<int>(e.status), 0xFF);
+                CHECK_TRUE(e.origin == LoopTraceOrigin::Radio);
+                if (d.delivered) {
+                    CHECK_EQ(static_cast<int>(e.loss), 0);
+                } else if (d.start_ns < 0) {
+                    CHECK_EQ(static_cast<int>(e.loss), static_cast<int>(LoopDownlinkLoss::NoGatewaySlot));
+                } else if (d.device_missed) {
+                    CHECK_EQ(static_cast<int>(e.loss), static_cast<int>(LoopDownlinkLoss::DeviceTransmitting));
+                } else {
+                    CHECK_EQ(static_cast<int>(e.loss), static_cast<int>(LoopDownlinkLoss::BelowSensitivity));
+                }
+            }
+            break;
+        case LoopTraceKind::Apply:
+            CHECK_TRUE(e.downlink < res.downlinks.size());
+            if (e.downlink < res.downlinks.size()) {
+                CHECK_TRUE(res.downlinks[e.downlink].delivered);
+                CHECK_EQ(static_cast<int>(e.uplink), static_cast<int>(res.downlinks[e.downlink].uplink));
+            }
+            CHECK_TRUE(e.status <= 0x07);
+            CHECK_TRUE(e.flag == (e.status == 0x07));
+            CHECK_TRUE(e.origin == LoopTraceOrigin::Normative);
+            break;
+        }
+    }
+}
