+                ("downlink_payload_bytes", ctypes.c_uint32), ("gateway_tx_power_dbm", ctypes.c_double),
+                ("device_antenna_gain_dbi", ctypes.c_double), ("device_rx_offset_db", ctypes.c_double)]
