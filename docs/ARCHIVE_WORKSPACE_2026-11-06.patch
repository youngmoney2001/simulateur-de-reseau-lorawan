+        if (!scheduled) {
+            t_open = ta.end + kLoopRx2DelayNs;
+            start = t_open;
+            rad.rx1_sf = kLoopRx2Sf;
+            if (plan::downlink_airtime_ns(rad, base + fopts, air) != lora::Status::Ok) {
