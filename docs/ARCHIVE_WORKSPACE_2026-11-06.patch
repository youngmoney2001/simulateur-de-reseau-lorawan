+SimStatus run_channels_at(const LoopChannelConfig* cfg, LoopChannelIo& io, LoopResult& res,
+                          SimulationStats& tot, DeviceStats* st, std::uint32_t messages, double x_m,
+                          double rx_offset_db = 0.0) {
