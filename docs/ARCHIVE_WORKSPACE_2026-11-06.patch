+// Trois états de LinkADRAns (TS001 §5) sur un balayage déterministe (distance x décalage passerelle) :
+//  (a) réponse appliquée par le terminal (Apply) ;
+//  (b) réponse reçue par le serveur (LinkAdrAns sur un uplink reçu portant le bit) ;
+//  (c) uplink porteur perdu : réponse non reçue, aucun LinkAdrAns, requête réémise au prochain uplink reçu.
+void test_linkadr_three_states_applied_received_and_carrier_lost() {
+    std::size_t applied = 0, received = 0, carrier_lost = 0, reissued = 0;
+    for (double gw_db : {0.0, 3.0, 6.0}) {
+        for (double x_m : {6000.0, 8000.0, 10000.0}) {
+            LoopChannelConfig cfg = cfg_all_dr();
+            LoopChannelIo io;
+            io.trace_v3 = true;
+            LoopResult res;
+            SimulationStats tot;
+            DeviceStats st[1];
+            CHECK_EQ(static_cast<int>(run_channels_gw(&cfg, io, res, tot, st, 240, x_m, gw_db, 0.0)), 0);
+            std::vector<int> answers(res.uplinks.size(), 0);
+            for (const LoopTraceEvent& e : io.trace) {
+                if (e.kind == LoopTraceKind::LinkAdrAns && e.uplink < answers.size()) ++answers[e.uplink];
+            }
+            // (b) et (c) : pour chaque uplink portant la réponse, présence du LinkAdrAns selon l'issue radio.
+            for (std::size_t i = 0; i < res.uplinks.size(); ++i) {
+                const LoopUplink& u = res.uplinks[i];
+                if ((u.answer_mask & 1U) == 0) continue;
+                if (u.outcome == TxOutcome::Received) {
+                    CHECK_EQ(answers[i], 1);
+                    ++received;
+                } else {
+                    CHECK_EQ(answers[i], 0);
+                    ++carrier_lost;
+                    // Réémission : une LinkADRReq du même dispositif est planifiée après la perte.
+                    bool later_rx = false;
+                    for (std::size_t j = i + 1; j < res.uplinks.size(); ++j) {
+                        if (res.uplinks[j].device == u.device && res.uplinks[j].outcome == TxOutcome::Received) {
+                            later_rx = true;
+                            break;
+                        }
+                    }
+                    if (later_rx) {
+                        bool replanned = false;
+                        for (const LoopTraceEvent& e : io.trace) {
+                            if (e.kind == LoopTraceKind::LinkAdrReq && e.device == u.device && e.uplink > i) {
+                                replanned = true;
+                                break;
+                            }
+                        }
+                        CHECK_TRUE(replanned);
+                        if (replanned) ++reissued;
+                    }
+                }
+            }
+            // (a) : chaque Apply est suivi, à la prochaine émission du dispositif, d'un uplink portant le bit.
+            for (const LoopTraceEvent& e : io.trace) {
+                if (e.kind != LoopTraceKind::Apply) continue;
+                ++applied;
+                bool found = false;
+                for (const LoopUplink& u : res.uplinks) {
+                    if (u.device != e.device || u.start_ns < e.t_ns) continue;
+                    found = true;
+                    CHECK_TRUE((u.answer_mask & 1U) != 0);
+                    break;
+                }
+                CHECK_TRUE(found);
+            }
+        }
+    }
+    // Non-vacuité : les trois états ont été observés sur le balayage.
+    CHECK_TRUE(applied > 0);
+    CHECK_TRUE(received > 0);
+    CHECK_TRUE(carrier_lost > 0);
+    CHECK_TRUE(reissued > 0);
+}
