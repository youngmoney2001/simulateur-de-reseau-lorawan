+// Trace v3 activée ou non, avec MAC (LinkCheck, DevStatus, DeviceTime) et trois dispositifs : tous
+// les résultats radio, MAC, descentes et réponses sont identiques.
+void test_trace_v3_on_off_identical_with_mac_and_three_devices() {
+    const std::vector<EndDeviceSpec> devs = {dev(10.0, 12, 0, 60 * kS, 60), dev(4000.0, 10, 7 * kS, 60 * kS, 60),
+                                             dev(8000.0, 12, 13 * kS, 60 * kS, 60)};
+    const std::vector<LoopMacSlot> slots = {
+        {0, 1, 1, kLoopMacLinkCheck}, {1, 2, 0, kLoopMacDevStatus}, {2, 3, 3, kLoopMacDeviceTime},
+        {0, 5, 2, kLoopMacDevStatus}, {1, 4, 0, kLoopMacLinkCheck},
+    };
+    LoopChannelConfig cfg = cfg_all_dr();
+    LoopChannelConfig cfg3[3] = {cfg, cfg, cfg};
+    auto run = [&](bool trace, LoopChannelIo& io, LoopResult& res, SimulationStats& tot,
+                   std::vector<DeviceStats>& st) {
+        std::vector<lsim::plan::DeviceRadio> rv;
+        std::vector<LoopRegion> regions;
+        for (std::size_t i = 0; i < devs.size(); ++i) {
+            rv.push_back(radio());
+            regions.push_back(region());
+        }
+        GatewaySpec gw;
+        gw.rx_sensitivity_offset_db = 3.0;
+        LoopOptions opt;
+        opt.adr = true;
+        opt.mac = slots.data();
+        opt.mac_count = slots.size();
+        io.config = cfg3;
+        io.config_count = 3;
+        io.trace_v3 = trace;
+        st.assign(devs.size(), DeviceStats{});
+        return simulate_closed_loop_channels(devs.data(), devs.size(), rv.data(), regions.data(), gw,
+                                             PropagationSpec{}, nullptr, opt, st.data(), tot, res, io);
+    };
+    LoopChannelIo off, on;
+    LoopResult ro, rn;
+    SimulationStats to, tn;
+    std::vector<DeviceStats> so, sn;
+    CHECK_EQ(static_cast<int>(run(false, off, ro, to, so)), 0);
+    CHECK_EQ(static_cast<int>(run(true, on, rn, tn, sn)), 0);
+    CHECK_TRUE(off.trace.empty());
+    CHECK_TRUE(!on.trace.empty());
+    // Radio : chaque uplink, à l'identique.
+    CHECK_EQ(static_cast<int>(ro.uplinks.size()), static_cast<int>(rn.uplinks.size()));
+    for (std::size_t i = 0; i < ro.uplinks.size() && i < rn.uplinks.size(); ++i) {
+        const LoopUplink& a = ro.uplinks[i];
+        const LoopUplink& b = rn.uplinks[i];
+        CHECK_EQ(static_cast<int>(a.device), static_cast<int>(b.device));
+        CHECK_TRUE(a.outcome == b.outcome && a.start_ns == b.start_ns && a.end_ns == b.end_ns);
+        CHECK_EQ(static_cast<int>(a.spreading_factor), static_cast<int>(b.spreading_factor));
+        CHECK_EQ(static_cast<int>(a.dr), static_cast<int>(b.dr));
+        CHECK_EQ(static_cast<int>(a.power_index), static_cast<int>(b.power_index));
+        CHECK_EQ(static_cast<int>(a.answer_mask), static_cast<int>(b.answer_mask));
+        CHECK_EQ(static_cast<int>(a.answer_ok), static_cast<int>(b.answer_ok));
+    }
+    // Descentes, passerelle, file MAC.
+    CHECK_EQ(static_cast<int>(ro.downlinks.size()), static_cast<int>(rn.downlinks.size()));
+    for (std::size_t i = 0; i < ro.downlinks.size() && i < rn.downlinks.size(); ++i) {
+        const LoopDownlink& a = ro.downlinks[i];
+        const LoopDownlink& b = rn.downlinks[i];
+        CHECK_EQ(static_cast<int>(a.uplink), static_cast<int>(b.uplink));
+        CHECK_EQ(static_cast<int>(a.commands), static_cast<int>(b.commands));
+        CHECK_EQ(static_cast<int>(a.queued), static_cast<int>(b.queued));
+        CHECK_TRUE(a.start_ns == b.start_ns && a.air_ns == b.air_ns && a.t_open == b.t_open);
+        CHECK_TRUE(a.device_missed == b.device_missed && a.delivered == b.delivered);
+        CHECK_EQ(static_cast<int>(a.req_dr), static_cast<int>(b.req_dr));
+        CHECK_EQ(static_cast<int>(a.req_power_index), static_cast<int>(b.req_power_index));
+    }
+    CHECK_TRUE(ro.gateway_busy.size() == rn.gateway_busy.size());
+    CHECK_EQ(static_cast<int>(ro.mac_items.size()), static_cast<int>(rn.mac_items.size()));
+    CHECK_TRUE(ro.mac.enqueued == rn.mac.enqueued && ro.mac.dispatched == rn.mac.dispatched);
+    CHECK_TRUE(ro.mac.delivered == rn.mac.delivered && ro.mac.dispatch_lost == rn.mac.dispatch_lost);
+    CHECK_TRUE(ro.mac.deferred == rn.mac.deferred && ro.mac.expired == rn.mac.expired);
+    CHECK_TRUE(ro.mac.pending_at_end == rn.mac.pending_at_end);
+    // Totaux et compteurs par dispositif.
+    CHECK_TRUE(to.sent == tn.sent && to.received == tn.received && to.airtime_ns == tn.airtime_ns);
+    CHECK_TRUE(to.lost_sensitivity == tn.lost_sensitivity && to.lost_collision == tn.lost_collision);
+    CHECK_TRUE(to.lost_gateway_busy == tn.lost_gateway_busy);
+    CHECK_EQ(static_cast<int>(so.size()), static_cast<int>(sn.size()));
+    for (std::size_t i = 0; i < so.size() && i < sn.size(); ++i) {
+        CHECK_TRUE(so[i].sent == sn[i].sent && so[i].received == sn[i].received);
+        CHECK_TRUE(so[i].airtime_ns == sn[i].airtime_ns);
+    }
+    // Réponses et état terminal.
+    CHECK_TRUE(off.uplink_status == on.uplink_status);
+    CHECK_EQ(static_cast<int>(off.downlink_requests.size()), static_cast<int>(on.downlink_requests.size()));
+    CHECK_EQ(static_cast<int>(off.terminals.size()), static_cast<int>(on.terminals.size()));
+    for (std::size_t i = 0; i < off.terminals.size() && i < on.terminals.size(); ++i) {
+        CHECK_EQ(static_cast<int>(off.terminals[i].dr), static_cast<int>(on.terminals[i].dr));
+        CHECK_TRUE(off.terminals[i].channels == on.terminals[i].channels);
+    }
+    // Les trois dispositifs ont émis : la comparaison couvre bien plusieurs dispositifs.
+    std::vector<bool> seen(devs.size(), false);
+    for (const LoopUplink& u : ro.uplinks) seen[u.device] = true;
+    for (bool s : seen) CHECK_TRUE(s);
+}
