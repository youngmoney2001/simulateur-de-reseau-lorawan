+    std::uint8_t answer_mask = 0;             // bit 0 : LinkADRAns, bit 1 : DutyCycleAns, bit 2 : DevStatusAns (portées)
+    std::uint8_t answer_ok = 0;               // bit 0 : débit acquitté, bit 1 : puissance acquittée
+};
