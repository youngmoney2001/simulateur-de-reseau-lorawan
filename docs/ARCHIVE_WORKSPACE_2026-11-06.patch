+// Sentinelles et drapeaux exhaustifs par type d'événement, sur quatre régimes : liaison normale,
+// pertes de liaison descendante avec obstacle de passerelle, pertes par sensibilité (110 dB), et
+// refus de canal (exclusions).
+void test_trace_v3_sentinels_and_flags_by_kind() {
+    // Valeurs par défaut du type : sentinelles, pas de données fictives.
+    LoopTraceEvent blank;
+    CHECK_TRUE(blank.kind == LoopTraceKind::Uplink);
+    CHECK_TRUE(blank.origin == LoopTraceOrigin::Normative);
+    CHECK_EQ(static_cast<int>(blank.downlink), static_cast<int>(kLoopNoIndex));
+    CHECK_EQ(static_cast<int>(blank.status), 0xFF);
+    CHECK_EQ(static_cast<int>(blank.loss), 0);
+    CHECK_TRUE(!blank.flag);
+
+    std::size_t kinds[7] = {0, 0, 0, 0, 0, 0, 0};
+    std::size_t loss_below = 0;
+    auto tally = [&](const LoopChannelIo& io, const LoopResult& res) {
+        check_trace_fields_by_kind(res, io.trace);
+        for (const LoopTraceEvent& e : io.trace) {
+            ++kinds[static_cast<std::size_t>(e.kind)];
+            if (e.kind == LoopTraceKind::Downlink && e.loss == 3) ++loss_below;
+        }
+    };
+    struct Regime {
+        double x_m;
+        double gw_offset_db;
+        double dev_rx_offset_db;
+    };
+    for (const Regime& r : {Regime{10.0, 0.0, 0.0}, Regime{8000.0, 6.0, 0.0}, Regime{10.0, 0.0, 110.0}}) {
+        LoopChannelConfig cfg = cfg_all_dr();
+        LoopChannelIo io;
+        io.trace_v3 = true;
+        LoopResult res;
+        SimulationStats tot;
+        DeviceStats st[1];
+        CHECK_EQ(static_cast<int>(run_channels_gw(&cfg, io, res, tot, st, 240, r.x_m, r.gw_offset_db,
+                                                  r.dev_rx_offset_db)), 0);
+        std::size_t rx = 0;
+        for (const LoopUplink& u : res.uplinks) rx += u.outcome == TxOutcome::Received ? 1 : 0;
+        std::size_t ul_ev = 0, dl_ev = 0;
+        for (const LoopTraceEvent& e : io.trace) {
+            ul_ev += e.kind == LoopTraceKind::Uplink ? 1 : 0;
+            dl_ev += e.kind == LoopTraceKind::Downlink ? 1 : 0;
+        }
+        CHECK_EQ(static_cast<int>(ul_ev), static_cast<int>(rx));
+        CHECK_EQ(static_cast<int>(dl_ev), static_cast<int>(res.downlinks.size()));
+        tally(io, res);
+    }
+    // Refus de canal : exclusions de débit, puissance et canal (même scénario que la trace partielle).
+    {
+        LoopChannelConfig cfg = cfg_default();
+        cfg.server_view.set(3);
+        cfg.server_view.set(4);
+        cfg.device.dr_mask[3] = 0;
+        cfg.device.enabled.reset(3);
+        LoopChannelIo io;
+        io.trace_v3 = true;
+        LoopResult res;
+        SimulationStats tot;
+        DeviceStats st[1];
+        CHECK_EQ(static_cast<int>(run_channels(&cfg, 1, io, res, tot, st, 240)), 0);
+        tally(io, res);
+    }
+    // Non-vacuité : chaque type d'événement et la perte par sensibilité sont observés.
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::Uplink)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::LinkAdrAns)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::Exclusion)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::AdrDecision)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::LinkAdrReq)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::Downlink)] > 0);
+    CHECK_TRUE(kinds[static_cast<std::size_t>(LoopTraceKind::Apply)] > 0);
+    CHECK_TRUE(loss_below > 0);
+}
