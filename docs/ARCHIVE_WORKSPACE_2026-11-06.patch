+    // Ouverture avec la mauvaise clé (AppSKey pour le port 0) : MIC rejeté.
+    SessionKeys10 wrong = k;
+    wrong.nwk_s_key = k.app_s_key;
+    DataFrame out;
+    CHECK_EQ(static_cast<int>(open_uplink_10(wire, n, wrong, Context10{5}, out)),
