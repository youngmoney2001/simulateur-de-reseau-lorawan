@@ -0,0 +1,90 @@
+"""Boucle fermée S2 (pont Python) : parité sans commande avec le chemin causal S1, convergence ADR,
+et refus des options invalides par le cœur."""
+
+import pytest
+
+from lsim.closed_loop import CMD_LINK_ADR, LoopOptions, LoopRegion, simulate_closed_loop
+from lsim.downlink_plan import simulate_causal
+from lsim.lora import StatusError
+from lsim.simulator import EndDevice, Gateway, Propagation
+from lsim.trace_events import DeviceRadio
+
+S = 1_000_000_000
+EU_REGION = LoopRegion(dr_sf=(12, 11, 10, 9, 8, 7) + (0,) * 10, max_dr=5, max_tx_power_index=7,
+                       power_step_tenth_db=20)
+
+
+def _radio():
+    return DeviceRadio(freq_hz=868_100_000, dr=None, rx1_hz=868_100_000)
+
+
+def test_no_command_parity_with_causal_path():
+    devices = [EndDevice(x_m=100.0, period_ns=30 * S, messages=20),
+               EndDevice(x_m=2500.0, spreading_factor=9, start_offset_ns=3 * S, period_ns=30 * S,
+                         messages=20),
+               EndDevice(x_m=900.0, start_offset_ns=7 * S, period_ns=30 * S, messages=20)]
+    radios = [_radio(), _radio(), _radio()]
+    gw, prop = Gateway(), Propagation()
+    causal, busy = simulate_causal(devices, gw, prop, None, radios, LoopOptions())
+    loop = simulate_closed_loop(devices, gw, prop, None, radios, [EU_REGION] * 3, LoopOptions())
+    assert loop.downlinks == ()
+    assert loop.busy == busy == ()
+    assert loop.totals == causal.totals
+    assert loop.per_device == causal.per_device
+    assert len(loop.uplinks) == 60
+
+
+def test_adr_converges_to_sf7_for_nearby_device():
+    devices = [EndDevice(x_m=10.0, spreading_factor=12, period_ns=60 * S, messages=300)]
+    out = simulate_closed_loop(devices, Gateway(), Propagation(), None, [_radio()], [EU_REGION],
+                               LoopOptions(adr=True))
+    assert out.uplinks[-1].spreading_factor == 7
+    assert any(d.delivered and d.commands & 1 for d in out.downlinks)
+
+
+def test_invalid_duty_cycle_exponent_is_refused_by_core():
+    devices = [EndDevice(x_m=10.0, messages=2)]
+    with pytest.raises(StatusError):
+        simulate_closed_loop(devices, Gateway(), Propagation(), None, [_radio()], [EU_REGION],
+                             LoopOptions(duty_cycle=True, duty_cycle_exponent=16))
+
+
+def _linkadr_sweep():
+    """Balayage déterministe (décalage passerelle x distance) : SF12, ADR actif, 240 uplinks."""
+    for gw_db in (0.0, 3.0, 6.0):
+        for x_m in (6000.0, 8000.0, 10000.0):
+            devices = [EndDevice(x_m=x_m, spreading_factor=12, period_ns=60 * S, messages=240)]
+            gateway = Gateway(rx_sensitivity_offset_db=gw_db)
+            yield simulate_closed_loop(devices, gateway, Propagation(), None, [_radio()], [EU_REGION],
+                                       LoopOptions(adr=True))
+
+
+def test_linkadr_three_states_visible_in_v2_outputs():
+    """LinkADRAns (TS001 §5), vue des sorties v2 : (a) réponse appliquée, (b) reçue par le serveur,
+    (c) uplink porteur perdu, suivi d'une réémission de LinkADRReq au prochain uplink reçu."""
+    applied = received_carrier = lost_carrier = reissued = 0
+    for out in _linkadr_sweep():
+        ups = out.uplinks
+        for i, up in enumerate(ups):
+            if not up.answer_mask & 1:
+                continue
+            if up.outcome == "received":
+                received_carrier += 1
+                continue
+            lost_carrier += 1
+            if any(v.device == up.device and v.outcome == "received" for v in ups[i + 1:]):
+                assert any(d.uplink > i and d.commands & CMD_LINK_ADR and ups[d.uplink].device == up.device
+                           for d in out.downlinks), "LinkADRReq non réémise après perte du porteur"
+                reissued += 1
+        for dl in out.downlinks:
+            if not (dl.delivered and dl.commands & CMD_LINK_ADR):
+                continue
+            applied += 1
+            # Réponse appliquée à la réception : portée par le premier uplink émis après la descente.
+            end_ns = dl.start_ns + dl.air_ns
+            nxt = next(u for u in ups if u.device == dl.device and u.start_ns >= end_ns)
+            assert nxt.answer_mask & 1, "réponse appliquée absente du prochain uplink"
+    assert applied > 0
+    assert received_carrier > 0
+    assert lost_carrier > 0
+    assert reissued > 0
diff --git a/python/tests/test_closed_loop_v3_native.py b/python/tests/test_closed_loop_v3_native.py
