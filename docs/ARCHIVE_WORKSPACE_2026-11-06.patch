+                    mi.state = LoopMacState::Expired;
+                    it = sv.queue.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+        }
+        if (adr_reqs[a] != 0 && kind == 0) kind = 3;  // F14 : ADRACKReq, descente obligatoire
