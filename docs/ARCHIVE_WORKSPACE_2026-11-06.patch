+// SPDX-License-Identifier: Apache-2.0
+// Validation interne des arguments de lsim_simulate_closed_loop_v3 (étape 6.2.2).
+// En-tête C++ interne, hors API publique (les symboles publics sont dans c_api.h), sans simulation ni écriture dans les sorties.
+#pragma once
+
+#include <cstdint>
+
+#include "lsim/c_api.h"
+
+namespace lsim::sim::abi_v3 {
+
+// Version d'ABI attendue dans `lsim_closed_loop_v3_args::abi_version` et dans chaque élément de
+// configuration canal. Valeur 3 : version de l'ABI v3.
+inline constexpr std::uint32_t kClosedLoopV3AbiVersion = 3;
+
+// Valide l'ensemble des arguments sans rien écrire. Retourne 0 si valide, sinon un code
+// LSIM_STATUS_CHANNEL_* (base 1000) ou un code historique (dont SIM + TooManyDevices).
+// Ordre de contrôle : pointeur d'arguments, alignement, en-tête, plan et mode canal, trace,
+// pointeurs obligatoires, tailles et débordements, alignements, chevauchements,
+// puis éléments de configuration canal (dispositif par dispositif, champ par champ).
+// Les capacités de sortie ne sont pas contrôlées ici : elles le sont après simulation (6.2.5).
+std::int32_t validate_closed_loop_v3_args(const lsim_closed_loop_v3_args* args);
+
+}  // namespace lsim::sim::abi_v3
diff --git a/core/include/lsim/downlink_plan.hpp b/core/include/lsim/downlink_plan.hpp
new file mode 100644
index 0000000..39cd285
--- /dev/null
+++ b/core/include/lsim/downlink_plan.hpp
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: Apache-2.0
+// Planification des descentes d'une passerelle unique (S0 de la refonte boucle fermée).
+//
+// Porte en C++ la logique de `python/lsim/trace_events.py` (`_downlink_jobs`, `_schedule_gateway`,
+// `_events`) pour le cas sans jointure et sans commande MAC. Entrée : les émissions montantes issues
+// du moteur (`TxRecord`) et les paramètres radio des dispositifs. Sortie : occupation de la passerelle
+// et événements de protocole, dans le même ordre que la version Python (même instant, même ordre
+// d'insertion). La version Python reste l'oracle de test tant que la parité n'est pas totale.
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "lsim/lora_phy.hpp"
+
+namespace lsim::plan {
+
+// Issue d'une émission montante (mêmes valeurs que `lsim::sim::TxOutcome`).
+enum class UplinkOutcome : std::uint8_t {
+    LostSensitivity = 0,
+    LostCollision = 1,
+    Received = 2,
+    LostGatewayBusy = 3,
+};
+
+// Codes des issues d'événements et de sauts (table de correspondance côté Python).
+enum class Outcome : std::uint8_t {
+    Received = 0,         // uplink reçu par la passerelle
+    LostSensitivity = 1,  // sous la sensibilité
+    LostCollision = 2,    // collision non capturée
+    LostGatewayBusy = 3,  // passerelle en émission pendant la trame
+    AckOnly = 4,          // ACK seul
+    Data = 5,             // downlink de données
+    DataAck = 6,          // downlink de données confirmé
+    GatewayBusy = 7,      // RX1 manquée : passerelle occupée
+    DeviceTransmitting = 8,  // RX1 manquée : le dispositif émet
+    Delivered = 9,        // saut livré
+    NotListened = 10,     // saut non écouté
+};
+
+enum class EventKind : std::uint8_t {
+    Uplink = 0,
+    Ack = 1,
+    Downlink = 2,
+    RxWindowMissed = 3,
+};
+
+enum class HopDir : std::uint8_t {
+    DevToGw = 0,
+    GwToNs = 1,
+    GwToDev = 2,
+};
+
+struct UplinkRecord {
+    std::uint32_t device = 0;
+    std::int64_t start_ns = 0;
+    std::int64_t end_ns = 0;
+    std::uint8_t spreading_factor = 7;
+    UplinkOutcome outcome = UplinkOutcome::LostSensitivity;
+    double rssi_dbm = 0.0;
+};
+
+struct DeviceRadio {
+    std::int64_t freq_hz = 868'100'000;
+    std::int32_t dr = -1;            // -1 : aucun débit de plan
+    std::int64_t rx1_hz = 868'100'000;
+    double tx_power_dbm = 14.0;
+    std::uint8_t rx1_sf = 7;
+    std::uint32_t rx1_bw_hz = 125'000;
+};
+
+struct PlanOptions {
+    bool confirmed_uplinks = false;
+    std::uint32_t downlink_every = 0;
+    std::uint32_t downlink_payload_bytes = 10;
+    double gateway_tx_power_dbm = 14.0;
+    double device_antenna_gain_dbi = 0.0;
+    double device_rx_offset_db = 0.0;
+};
+
+struct Hop {
+    HopDir dir = HopDir::DevToGw;
+    Outcome outcome = Outcome::Delivered;
+    bool has_rssi = false;
+    double rssi_dbm = 0.0;
+    std::int64_t t_ns = 0;
+    std::int64_t freq_hz = 0;
+    std::int32_t dr = -1;
+};
+
+struct Event {
+    std::int64_t t_ns = 0;
+    std::uint32_t device = 0;
+    EventKind kind = EventKind::Uplink;
+    Outcome outcome = Outcome::Received;
+    std::vector<Hop> hops;  // au plus 2 sauts
+};
+
+struct Interval {
+    std::int64_t start_ns = 0;
+    std::int64_t end_ns = 0;
+};
+
+enum class PlanStatus : std::int32_t {
+    Ok = 0,
+    InvalidInput = 1,
+    InvalidRadio = 2,
+    InvalidOptions = 3,
+};
+
+// Planifie les descentes. `uplinks` doit être dans l'ordre de la trace (début croissant par
+// dispositif). `events` et `busy` reçoivent le résultat (remplacés).
+PlanStatus plan_downlinks(const std::vector<UplinkRecord>& uplinks,
+                          const std::vector<DeviceRadio>& radios, const PlanOptions& options,
+                          std::vector<Event>& events, std::vector<Interval>& busy);
+
+// Durée d'un downlink de `payload_bytes` au débit RX1 du dispositif (CR 4/5, en-tête explicite,
+// sans CRC, préambule 8, optimisation bas débit si Tsym > 16 ms), en ns.
+lora::Status downlink_airtime_ns(const DeviceRadio& radio, std::uint32_t payload_bytes,
+                                 std::int64_t& out_ns);
+
+// Planificateur incrémental (S1) : mêmes règles que `plan_downlinks`, appelé à la fin de chaque trame
+// montante reçue, dans l'ordre temporel des fins. Ne donne que l'occupation passerelle (ce qui décide
+// des pertes montantes) ; les événements restent produits par `plan_downlinks`.
+class DownlinkScheduler {
+public:
+    DownlinkScheduler(const std::vector<DeviceRadio>& radios, const PlanOptions& options);
+
+    PlanStatus status() const { return status_; }
+
+    // Trame montante reçue par la passerelle, à `end_ns`. Retourne l'émission passerelle planifiée,
+    // ou nullopt (pas de réponse attendue, ou fenêtre RX1 perdue faute de passerelle libre).
+    // Les appels doivent se succéder par fins croissantes (ordre de la trace).
+    std::optional<Interval> on_received(std::uint32_t device, std::int64_t end_ns);
+
+private:
+    PlanOptions options_;
+    std::vector<DeviceRadio> radios_;
+    std::vector<std::uint32_t> accepted_;
+    std::vector<std::int64_t> ack_air_;  // 0 = non calculée
+    std::vector<std::int64_t> data_air_;
+    PlanStatus status_ = PlanStatus::Ok;
+    bool any_busy_ = false;
+    std::int64_t busy_until_ = 0;
+};
+
+}  // namespace lsim::plan
diff --git a/core/include/lsim/loop_adr.hpp b/core/include/lsim/loop_adr.hpp
new file mode 100644
index 0000000..ae3846c
--- /dev/null
+++ b/core/include/lsim/loop_adr.hpp
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: Apache-2.0
+// Modèle des canaux et de LinkADRReq / LinkADRAns pour la boucle fermée (étape 1 de la
+// correction ChannelMask). API C++ interne : aucune fonction de l'ABI C n'utilise ces types.
+//
+// Sources normatives :
+//   * TS001-1.0.4 Table 22 : LinkADRAns Status, bit 0 = ChannelMaskACK, bit 1 = DataRateACK,
+//     bit 2 = PowerACK (ordre protocolaire, appliqué uniquement dans to_wire / from_wire) ;
+//   * TS001-1.0.4 Table 23 : sens de chaque bit ; un bit à 0 = commande non réussie ;
+//   * TS001-1.0.4 §5.2 : bloc de LinkADRReq contigus traité comme une commande atomique ;
+//     un bit à 0 : le terminal conserve son état précédent ;
+//   * RP002-1.0.5 §3.4.5 et Table 14 : ChMaskCntl EU863-870 (0..4 blocs de 16, 5 banques de 8,
+//     6 = tous les canaux définis ON, 7 = RFU) ;
+//   * RP002-1.0.5 Table 8 : canaux par défaut 868.1 / 868.3 / 868.5 MHz, DR0 à DR5.
+//
+// Convention interne du simulateur (non normative) : chaque bit indique la validité de son
+// propre paramètre. L'application reste atomique : si un bit vaut 0, rien n'est appliqué.
+//
+// Règles de validation (évaluation dans cet ordre, déterministe) :
+//   1. Masque : ChMaskCntl RFU -> refus, motif RfuCntl ; ChMaskCntl 5 avec un bit RFU non nul
+//      (bits 10 à 15) -> refus, motif RfuBits (convention du simulateur : un masque invalide
+//      n'est jamais accepté, même si la norme ne décrit pas ce cas).
+//   2. Masque : canal activé non défini -> refus, motif UndefinedChannel ; canaux refusés
+//      = ceux activés et non définis.
+//   3. Masque : aucun canal actif après la commande -> refus, motif AllDisabled.
+//   4. Débit : DR 0xF = ignoré ; DR hors plan (non modélisé) -> refus, motif UnknownDr ;
+//      sinon le débit est évalué sur l'état résultant si le masque est valide, sinon sur
+//      l'état courant. Aucun canal actif ne supporte ce débit -> refus, motif
+//      NotSupportedByChannels.
+//   5. Compatibilité (TS001 Table 23) : si le masque est valide et que le débit (demandé ou
+//      courant, s'il est ignoré) n'est supporté par aucun canal actif résultant, le bit
+//      ChannelMaskACK vaut 0 avec le motif IncompatibleWithDataRate. Attribution (D5) : au
+//      débit si le débit est demandé, au masque sinon.
+//   6. Puissance : 0xF = ignorée ; index 0..7 valides ; 8..14 réservés (RFU) -> refus,
+//      motif Reserved.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace lsim::sim {
+
+// RP002-1.0.5 EU863-870 : 24 à 80 canaux ; le modèle en stocke 80 au plus.
+inline constexpr std::size_t kLoopMaxChannels = 80;
+inline constexpr std::uint8_t kLoopEuMaxDr = 7;         // DR0..DR7 (DR7 FSK non modélisé)
+inline constexpr std::uint8_t kLoopEuMaxPowerIndex = 7; // RP002 Table 13 : 0..7 utilisables
+inline constexpr std::uint8_t kLoopFieldIgnore = 15;    // TS001 : 0xF = conserver la valeur
+
+// Ensemble de 80 canaux (deux mots de 64 bits).
+struct LoopChannelSet {
+    std::array<std::uint64_t, 2> words{};
+
+    bool test(std::size_t channel) const;
+    void set(std::size_t channel);
+    void reset(std::size_t channel);
+    bool any() const;
+    std::size_t count() const;
+    bool operator==(const LoopChannelSet& other) const;
+};
+
+// État canal d'un terminal : pour chaque canal, les débits qu'il supporte (bit n = DRn) ;
+// 0 = canal non défini. `enabled` : canaux actifs pour l'émission.
+struct LoopChannelState {
+    std::array<std::uint8_t, kLoopMaxChannels> dr_mask{};
+    LoopChannelSet enabled;
+
+    bool defined(std::size_t channel) const;
+    LoopChannelSet defined_set() const;
+    // Vrai si au moins un canal de `set` supporte le débit `dr`.
+    bool supports_dr(const LoopChannelSet& set, std::uint8_t dr) const;
+    bool operator==(const LoopChannelState& other) const;
+};
+
+// Exclusions après refus (étape 4). Durée : 5 fenêtres ADR de 20 uplinks admissibles reçus, soit
+// 100 uplinks (convention du simulateur, les fenêtres ADR ne sont pas normatives). Chaque valeur a
+// son compteur : un débit exclu n'exclut ni un autre débit, ni une puissance, ni le masque.
+// Un uplink admissible reçu décrémente tous les compteurs actifs ; à 0, l'exclusion expire.
+// Le renouvellement remet le compteur à 100. L'expiration ne déclenche aucune commande.
+inline constexpr std::uint16_t kLoopExclusionUplinks = 100;
+
+// Cible d'une exclusion. `Mask` : le masque demandé complet (politique du simulateur, suspects vides).
+enum class LoopExclusionTarget : std::uint8_t { DataRate, Power, Channel, Mask };
+
+// Exclusion arrivée à échéance lors d'un `tick`.
+struct LoopExpiry {
+    LoopExclusionTarget target = LoopExclusionTarget::DataRate;
+    std::uint16_t value = 0;
+};
+
+struct LoopExclusions {
+    std::array<std::uint16_t, 16> dr{};     // uplinks admissibles restants par débit ; 0 = éligible
+    std::array<std::uint16_t, 16> power{};  // idem par index de puissance
+    std::array<std::uint16_t, kLoopMaxChannels> channel{};  // par canal ; 0 = éligible
+    // Masque demandé complet (bloc 0) exclu : une seule case. Ne bloque que ce masque exact.
+    std::uint16_t mask_value = 0;
+    std::uint16_t mask = 0;                                  // uplinks restants ; 0 = aucun
+
+    // Pose (ou renouvelle) l'exclusion. Retourne vrai si la même exclusion était déjà active
+    // (renouvellement). Une exclusion de masque remplace une exclusion de masque différente.
+    bool exclude_dr(std::uint8_t dr);
+    bool exclude_power(std::uint8_t power_index);
+    bool exclude_channel(std::size_t channel_index);
+    bool exclude_mask(std::uint16_t block0);
+    bool mask_excluded(std::uint16_t block0) const;
+    // Un uplink admissible reçu : décrémente les compteurs actifs. `expired` (optionnel) reçoit les
+    // exclusions qui arrivent à 0 à cet uplink.
+    void tick(std::vector<LoopExpiry>* expired = nullptr);
+    bool dr_excluded(std::uint8_t dr) const;
+    bool power_excluded(std::uint8_t power_index) const;
+    bool channel_excluded(std::size_t channel_index) const;
+};
+
+// Masque du bloc 0 à demander : vue serveur privée des canaux exclus. Repli sur le dernier masque
+// confirmé si ce candidat est vide ou égal au masque exclu (politique du simulateur).
+std::uint16_t loop_request_block0(const LoopChannelSet& view, const LoopExclusions& excl,
+                                  const LoopChannelSet& confirmed);
+
+// Terminal complet (partie radio pertinente pour LinkADR).
+struct LoopTerminalRadio {
+    LoopChannelState channels;
+    std::uint8_t dr = 0;
+    std::uint8_t power_index = 0;
+    bool operator==(const LoopTerminalRadio& other) const;
+};
+
+// Plan régional connu du serveur : canaux par défaut, débits et puissances valides.
+// Ce n'est pas l'état du terminal : le serveur et le terminal ont chacun leur vue.
+struct LoopRegionalPlan {
+    LoopChannelSet defaults;               // canaux par défaut (RP002 Table 8)
+    std::uint8_t default_dr_mask = 0;      // débits supportés par les canaux par défaut
+    std::uint8_t dr_available = 0xFF;      // bit n = DRn utilisable (table du plan / de la région)
+    std::uint8_t max_dr = 0;
+    std::uint8_t max_power_index = 0;
+    std::size_t max_channels = kLoopMaxChannels;
+};
+
+// Plan EU863-870 (RP002-1.0.5) : défauts 0..2 avec DR0..DR5.
+LoopRegionalPlan loop_eu868_plan();
+
+// État canal par défaut d'un terminal EU863-870 : canaux 0..2 définis, actifs, DR0..DR5.
+LoopChannelState loop_eu868_default_channels();
+
+// LinkADRReq tel que reçu par le terminal.
+struct LoopLinkAdrRequest {
+    std::uint8_t ch_mask_cntl = 0;   // 0..7 (EU863-870)
+    std::uint16_t ch_mask = 0;
+    std::uint8_t dr = kLoopFieldIgnore;
+    std::uint8_t power_index = kLoopFieldIgnore;
+};
+
+// Bits de LinkADRAns. L'ordre protocolaire n'existe que dans to_wire / from_wire.
+struct LoopAdrStatus {
+    bool channel_mask_ack = false;   // bit 0 (TS001 Table 22)
+    bool data_rate_ack = false;      // bit 1
+    bool power_ack = false;          // bit 2
+
+    bool all() const { return channel_mask_ack && data_rate_ack && power_ack; }
+    std::uint8_t to_wire() const;               // octet d'état de LinkADRAns
+    static LoopAdrStatus from_wire(std::uint8_t status);  // bits RFU 3..7 ignorés
+    bool operator==(const LoopAdrStatus& other) const;
+};
+
+enum class LoopChannelReason : std::uint8_t {
+    Ok,
+    RfuCntl,
+    UndefinedChannel,
+    AllDisabled,
+    IncompatibleWithDataRate,
+    RfuBits,
+};
+
+enum class LoopDataRateReason : std::uint8_t {
+    Ok,
+    Ignored,
+    UnknownDr,
+    NotSupportedByChannels,
+};
+
+enum class LoopPowerReason : std::uint8_t {
+    Ok,
+    Ignored,
+    Reserved,
+};
+
+// Diagnostic d'une commande : bits individuels, motifs exacts et attribution pour les
+// exclusions côté serveur (D5 : refus croisé attribué au débit).
+struct LoopLinkAdrDiagnosis {
+    LoopAdrStatus status;
+    LoopChannelReason channel_reason = LoopChannelReason::Ok;
+    LoopDataRateReason dr_reason = LoopDataRateReason::Ok;
+    LoopPowerReason power_reason = LoopPowerReason::Ok;
+    LoopChannelSet refused_channels;   // canaux activés demandés et non définis
+    bool refuse_dr = false;            // débit à exclure côté serveur
+    bool refuse_power = false;         // puissance à exclure côté serveur
+};
+
+// Validation pure : ne modifie ni le terminal ni le plan.
+LoopLinkAdrDiagnosis loop_validate_link_adr(const LoopRegionalPlan& plan,
+                                            const LoopTerminalRadio& current,
+                                            const LoopLinkAdrRequest& request);
+
+// Application atomique : si le diagnostic n'est pas entièrement positif, le terminal reste
+// strictement inchangé. Retourne le diagnostic dans tous les cas.
+LoopLinkAdrDiagnosis loop_apply_link_adr(const LoopRegionalPlan& plan, LoopTerminalRadio& terminal,
+                                         const LoopLinkAdrRequest& request);
+
+}  // namespace lsim::sim
diff --git a/core/src/c_api_closed_loop_v3.cpp b/core/src/c_api_closed_loop_v3.cpp
new file mode 100644
index 0000000..2a62aa5
--- /dev/null
+++ b/core/src/c_api_closed_loop_v3.cpp
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: Apache-2.0
+// Point d'entrée public lsim_simulate_closed_loop_v3 (étape 6.3).
+//
+// Chaîne d'appel : validation (closed_loop_v3_validate) ; adaptation des entrées C vers le moteur ;
+// moteur canal (simulate_closed_loop_channels) ; sorties atomiques (emit_closed_loop_v3).
+// Aucune écriture utilisateur n'a lieu avant `emit_closed_loop_v3`, donc aucune sur erreur de
+// validation, d'environnement ou de moteur.
+//
+// Les adaptateurs C vers C++ (sensibilité absolue, environnement, entrées du moteur) sont des copies
+// de ceux de c_api_ext.cpp, placées ici dans un espace anonyme. v1, v2 et gw2 ne sont pas modifiées.
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "lsim/c_api.h"
+#include "lsim/closed_loop_v3_config.hpp"
+#include "lsim/closed_loop_v3_output.hpp"
+#include "lsim/closed_loop_v3_validate.hpp"
+#include "lsim/engine.hpp"
+#include "lsim/environment.hpp"
+#include "lsim/loop_adr.hpp"
+
+namespace {
+
+// Borne de sortie par run : identique à c_api_ext.cpp (kMaxTraceRecords).
+constexpr std::uint64_t kMaxTraceRecords = 200'000;
+
+// Sensibilité absolue : copie de c_api_ext.cpp (to_absolute).
+lsim::sim::GatewayAbsoluteSensitivity to_absolute(const lsim_gateway_v2* gw2) {
+    lsim::sim::GatewayAbsoluteSensitivity a;
+    if (gw2 == nullptr || gw2->sensitivity_model == LSIM_SENSITIVITY_MODEL_NONE) return a;
+    a.enabled = true;
+    a.present = gw2->present;
+    for (std::size_t b = 0; b < 3; ++b) {
+        for (std::size_t k = 0; k < 8; ++k) a.dbm[b][k] = gw2->sensitivity_dbm[b][k];
+    }
+    return a;
+}
+
+// Environnement : copie de c_api_ext.cpp (build_environment).
+int32_t build_environment(const lsim_environment* in, lsim::env::ElevationGrid& grid,
+                          std::vector<lsim::env::Obstacle>& obstacles, lsim::env::Environment& out) {
+    out = lsim::env::Environment{};
+    out.gateway_height_m = in->gateway_height_m;
+    out.device_height_m = in->device_height_m;
+    if (in->obstacle_count > 0 && in->obstacles == nullptr) {
+        return LSIM_STATUS_ENV_BASE + static_cast<int32_t>(lsim::env::EnvStatus::InvalidInput);
+    }
+    if (in->obstacle_count > lsim::env::kMaxObstacles) {
+        return LSIM_STATUS_ENV_BASE + static_cast<int32_t>(lsim::env::EnvStatus::TooManyObstacles);
+    }
+    obstacles.resize(in->obstacle_count);
+    for (std::size_t i = 0; i < in->obstacle_count; ++i) {
+        const lsim_obstacle& o = in->obstacles[i];
+        obstacles[i].x_min_m = o.x_min_m;
+        obstacles[i].y_min_m = o.y_min_m;
+        obstacles[i].x_max_m = o.x_max_m;
+        obstacles[i].y_max_m = o.y_max_m;
+        obstacles[i].height_m = o.height_m;
+        obstacles[i].attenuation_db = o.attenuation_db;
+    }
+    out.obstacles = obstacles.data();
+    out.obstacle_count = obstacles.size();
+    if (in->grid_z != nullptr) {
+        const std::size_t count = static_cast<std::size_t>(in->grid_nx) * in->grid_ny;
+        const auto st = lsim::env::make_elevation_grid(in->grid_origin_x_m, in->grid_origin_y_m,
+                                                       in->grid_cell_m, in->grid_nx, in->grid_ny,
+                                                       in->grid_z, count, grid);
+        if (st != lsim::env::EnvStatus::Ok) {
+            return LSIM_STATUS_ENV_BASE + static_cast<int32_t>(st);
+        }
+        out.grid = &grid;
+    }
+    return 0;
+}
+
+// Exécution après validation. Ne touche aux sorties utilisateur qu'à travers emit_closed_loop_v3.
+int32_t run_closed_loop_v3(const lsim_closed_loop_v3_args& a) {
+    const std::size_t n = a.device_count;
+
+    std::uint64_t planned = 0;
+    for (std::size_t i = 0; i < n; ++i) planned += a.devices[i].messages;
+    if (planned > kMaxTraceRecords) {
+        return LSIM_STATUS_SIM_BASE + static_cast<int32_t>(lsim::sim::SimStatus::TraceTooLarge);
+    }
+
+    // Dispositifs, radios et régions.
+    std::vector<lsim::sim::EndDeviceSpec> specs(n);
+    for (std::size_t i = 0; i < n; ++i) {
+        const lsim_end_device& d = a.devices[i];
+        lsim::sim::EndDeviceSpec& s = specs[i];
+        s.position.x_m = d.x_m;
+        s.position.y_m = d.y_m;
+        s.spreading_factor = d.spreading_factor;
+        s.payload_bytes = d.payload_bytes;
+        s.tx_power_dbm = d.tx_power_dbm;
+        s.start_offset_ns = d.start_offset_ns;
+        s.period_ns = d.period_ns;
+        s.messages = d.messages;
+        s.duty_cycle = d.duty_cycle;
+    }
+    std::vector<lsim::plan::DeviceRadio> rv(n);
+    for (std::size_t i = 0; i < n; ++i) {
+        const lsim_plan_device& d = a.radios[i];
+        lsim::plan::DeviceRadio& r = rv[i];
+        r.freq_hz = d.freq_hz;
+        r.dr = d.dr;
+        r.rx1_hz = d.rx1_hz;
+        r.tx_power_dbm = d.tx_power_dbm;
+        r.rx1_sf = d.rx1_sf;
+        r.rx1_bw_hz = d.rx1_bw_hz;
+    }
+    std::vector<lsim::sim::LoopRegion> rg(n);
+    for (std::size_t i = 0; i < n; ++i) {
+        for (std::size_t k = 0; k < 16; ++k) {
+            rg[i].dr_sf[k] = a.regions[i].dr_sf[k];
+            rg[i].duty_limit[k] = a.regions[i].duty_limit[k];
+        }
+        rg[i].max_dr = a.regions[i].max_dr;
+        rg[i].max_tx_power_index = a.regions[i].max_tx_power_index;
+        rg[i].power_step_tenth_db = a.regions[i].power_step_tenth_db;
+        rg[i].max_eirp_dbm = a.regions[i].max_eirp_dbm;
+    }
+
+    // Options du protocole et MAC (mêmes conversions que closed_loop_impl de c_api_ext.cpp).
+    lsim::sim::LoopOptions lo;
+    const lsim_plan_options& po = a.options->protocol;
+    lo.protocol.confirmed_uplinks = po.confirmed_uplinks != 0;
+    lo.protocol.downlink_every = po.downlink_every;
+    lo.protocol.downlink_payload_bytes = po.downlink_payload_bytes;
+    lo.protocol.gateway_tx_power_dbm = po.gateway_tx_power_dbm;
+    lo.protocol.device_antenna_gain_dbi = po.device_antenna_gain_dbi;
+    lo.protocol.device_rx_offset_db = po.device_rx_offset_db;
+    lo.adr = a.options->adr != 0;
+    lo.installation_margin_tenth_db = a.options->installation_margin_tenth_db;
+    lo.duty_cycle = a.options->duty_cycle != 0;
+    lo.duty_cycle_exponent = a.options->duty_cycle_exponent;
+    std::vector<lsim::sim::LoopMacSlot> slots;
+    slots.reserve(a.mac_count);
+    for (std::size_t m = 0; m < a.mac_count; ++m) {
+        lsim::sim::LoopMacSlot s;
+        s.device = a.mac[m].device_index;
+        s.rank = a.mac[m].rank;
+        s.extra_bytes = a.mac[m].extra_bytes;
+        s.flags = a.mac[m].flags;
+        slots.push_back(s);
+    }
+    lo.mac = slots.data();
+    lo.mac_count = slots.size();
+
+    // Options et radios validées avant simulation (mêmes codes que lsim_plan_downlinks_v1).
+    const lsim::plan::DownlinkScheduler probe(rv, lo.protocol);
+    if (probe.status() != lsim::plan::PlanStatus::Ok) {
+        return LSIM_STATUS_PLAN_BASE + static_cast<int32_t>(probe.status());
+    }
+
+    // Passerelle (gw2) : refus des modèles de sensibilité inconnus, comme gw2.
+    if (a.gateway->sensitivity_model > LSIM_SENSITIVITY_MODEL_ABSOLUTE_PER_SF_V2) {
+        return LSIM_STATUS_SIM_BASE + static_cast<int32_t>(lsim::sim::SimStatus::InvalidInput);
+    }
+    const lsim::sim::GatewayAbsoluteSensitivity absolute = to_absolute(a.gateway);
+    lsim::sim::GatewaySpec g;
+    g.position.x_m = a.gateway->base.x_m;
+    g.position.y_m = a.gateway->base.y_m;
+    g.antenna_gain_dbi = a.gateway->base.antenna_gain_dbi;
+    g.rx_sensitivity_offset_db = a.gateway->base.rx_sensitivity_offset_db;
+    g.absolute = absolute;
+
+    lsim::sim::PropagationSpec p;
+    p.frequency_hz = a.prop->frequency_hz;
+    p.reference_distance_m = a.prop->reference_distance_m;
+    p.exponent = a.prop->exponent;
+    p.capture_threshold_db = a.prop->capture_threshold_db;
+    p.shadowing_sigma_db = a.prop->shadowing_sigma_db;
+    p.shadowing_seed = a.prop->shadowing_seed;
+
+    lsim::env::ElevationGrid grid;
+    std::vector<lsim::env::Obstacle> obstacles;
+    lsim::env::Environment e;
+    if (a.env != nullptr) {
+        const int32_t built = build_environment(a.env, grid, obstacles, e);
+        if (built != 0) return built;
+    }
+
+    // Configuration canal : absente en mode historique (chemin moteur par défaut), explicite sinon.
+    std::vector<lsim::sim::LoopChannelConfig> configs;
+    lsim::sim::LoopChannelIo io;
+    io.trace_v3 = a.trace_enabled == 1;
+    if (!lsim::sim::abi_v3::is_historical_channel_mode(a)) {
+        configs = lsim::sim::abi_v3::build_channel_configs(a);
+        io.config = configs.data();
+        io.config_count = configs.size();
+    }
+
+    // Moteur canal.
+    std::vector<lsim::sim::DeviceStats> stats(n);
+    lsim::sim::SimulationStats tot;
+    lsim::sim::LoopResult res;
+    const lsim::sim::SimStatus st = lsim::sim::simulate_closed_loop_channels(
+        specs.data(), n, rv.data(), rg.data(), g, p, a.env != nullptr ? &e : nullptr, lo, stats.data(),
+        tot, res, io);
+    if (st != lsim::sim::SimStatus::Ok) {
+        return LSIM_STATUS_SIM_BASE + static_cast<int32_t>(st);
+    }
+
+    // Sorties : écriture atomique, uniquement après succès du moteur.
+    lsim::sim::abi_v3::EngineOutputs out;
+    out.per_device = std::move(stats);
+    out.totals = tot;
+    out.result = std::move(res);
+    out.io = std::move(io);
+    return lsim::sim::abi_v3::emit_closed_loop_v3(&a, 0, out);
+}
+
+}  // namespace
+
+extern "C" {
+
+int32_t lsim_simulate_closed_loop_v3(const lsim_closed_loop_v3_args* args) {
+    const int32_t valid = lsim::sim::abi_v3::validate_closed_loop_v3_args(args);
+    if (valid != 0) return valid;
+    try {
+        return run_closed_loop_v3(*args);
+    } catch (...) {
+        return LSIM_STATUS_INTERNAL;
+    }
+}
+
+}  // extern "C"
diff --git a/core/src/c_api_plan.cpp b/core/src/c_api_plan.cpp
new file mode 100644
index 0000000..678be7c
--- /dev/null
+++ b/core/src/c_api_plan.cpp
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+// Frontière C de la planification des descentes (lsim_plan_downlinks_v1).
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "lsim/c_api.h"
+#include "lsim/downlink_plan.hpp"
+
+namespace {
+
+using lsim::plan::DeviceRadio;
+using lsim::plan::Event;
+using lsim::plan::Interval;
+using lsim::plan::PlanOptions;
+using lsim::plan::PlanStatus;
+using lsim::plan::UplinkRecord;
+
+int32_t map_status(PlanStatus s) {
+    switch (s) {
+        case PlanStatus::Ok: return 0;
+        case PlanStatus::InvalidInput: return LSIM_STATUS_PLAN_BASE + 1;
+        case PlanStatus::InvalidRadio: return LSIM_STATUS_PLAN_BASE + 2;
+        case PlanStatus::InvalidOptions: return LSIM_STATUS_PLAN_BASE + 3;
+    }
+    return LSIM_STATUS_INTERNAL;
+}
+
+}  // namespace
+
+int32_t lsim_plan_downlinks_v1(const lsim_plan_uplink* uplinks, size_t uplink_count,
+                               const lsim_plan_device* devices, size_t device_count,
+                               const lsim_plan_options* options,
+                               lsim_plan_event* events, size_t event_capacity,
+                               size_t* event_count,
+                               lsim_interval* busy, size_t busy_capacity,
+                               size_t* busy_count) {
+    if (event_count == nullptr || busy_count == nullptr || options == nullptr) {
+        return LSIM_STATUS_PLAN_BASE + 1;
+    }
+    if ((uplink_count > 0 && uplinks == nullptr) || (device_count > 0 && devices == nullptr)) {
+        return LSIM_STATUS_PLAN_BASE + 1;
+    }
+    try {
+        std::vector<UplinkRecord> ups(uplink_count);
+        for (size_t i = 0; i < uplink_count; ++i) {
+            const lsim_plan_uplink& u = uplinks[i];
+            if (u.outcome > 3) return LSIM_STATUS_PLAN_BASE + 1;
+            ups[i].device = u.device_index;
+            ups[i].start_ns = u.start_ns;
+            ups[i].end_ns = u.end_ns;
+            ups[i].spreading_factor = u.spreading_factor;
+            ups[i].outcome = static_cast<lsim::plan::UplinkOutcome>(u.outcome);
+            ups[i].rssi_dbm = u.rssi_dbm;
+        }
+        std::vector<DeviceRadio> radios(device_count);
+        for (size_t i = 0; i < device_count; ++i) {
+            const lsim_plan_device& d = devices[i];
+            radios[i].freq_hz = d.freq_hz;
+            radios[i].dr = d.dr;
+            radios[i].rx1_hz = d.rx1_hz;
+            radios[i].tx_power_dbm = d.tx_power_dbm;
+            radios[i].rx1_sf = d.rx1_sf;
+            radios[i].rx1_bw_hz = d.rx1_bw_hz;
+        }
+        PlanOptions po;
+        po.confirmed_uplinks = options->confirmed_uplinks != 0;
+        po.downlink_every = options->downlink_every;
+        po.downlink_payload_bytes = options->downlink_payload_bytes;
+        po.gateway_tx_power_dbm = options->gateway_tx_power_dbm;
+        po.device_antenna_gain_dbi = options->device_antenna_gain_dbi;
+        po.device_rx_offset_db = options->device_rx_offset_db;
+
+        std::vector<Event> evs;
+        std::vector<Interval> bus;
+        const PlanStatus st = lsim::plan::plan_downlinks(ups, radios, po, evs, bus);
+        if (st != PlanStatus::Ok) return map_status(st);
+
+        *event_count = evs.size();
+        *busy_count = bus.size();
+        if (evs.size() > event_capacity || bus.size() > busy_capacity) {
+            return LSIM_STATUS_PLAN_BASE + 4;
+        }
+        for (size_t k = 0; k < evs.size(); ++k) {
+            const Event& e = evs[k];
+            lsim_plan_event& out = events[k];
+            out.t_ns = e.t_ns;
+            out.device_index = e.device;
+            out.kind = static_cast<uint8_t>(e.kind);
+            out.outcome = static_cast<uint8_t>(e.outcome);
+            out.hop_count = static_cast<uint8_t>(e.hops.size());
+            for (size_t h = 0; h < e.hops.size() && h < 2; ++h) {
+                out.hops[h].dir = static_cast<uint8_t>(e.hops[h].dir);
+                out.hops[h].outcome = static_cast<uint8_t>(e.hops[h].outcome);
+                out.hops[h].has_rssi = e.hops[h].has_rssi ? 1 : 0;
+                out.hops[h].t_ns = e.hops[h].t_ns;
+                out.hops[h].freq_hz = e.hops[h].freq_hz;
+                out.hops[h].dr = e.hops[h].dr;
+                out.hops[h].rssi_dbm = e.hops[h].rssi_dbm;
+            }
+        }
+        for (size_t k = 0; k < bus.size(); ++k) {
+            busy[k].start_ns = bus[k].start_ns;
+            busy[k].end_ns = bus[k].end_ns;
+        }
+        return 0;
+    } catch (...) {
+        return LSIM_STATUS_INTERNAL;
+    }
+}
diff --git a/core/src/closed_loop_v3_config.cpp b/core/src/closed_loop_v3_config.cpp
new file mode 100644
index 0000000..40c245a
--- /dev/null
+++ b/core/src/closed_loop_v3_config.cpp
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: Apache-2.0
+// Liaison interne entre la configuration canal v3 et le moteur (étape 6.2.3).
+#include "lsim/closed_loop_v3_config.hpp"
+
+#include <cstddef>
+#include <cstdint>
+
+#include "lsim/loop_adr.hpp"
+
+namespace lsim::sim::abi_v3 {
+namespace {
+
+// Bit c d'un tableau d'octets LSB d'abord : octet c / 8, bit c % 8 (convention de l'ABI v3).
+bool bit_at(const std::uint8_t* bytes, std::size_t channel) {
+    return ((bytes[channel / 8U] >> (channel % 8U)) & 1U) != 0;
+}
+
+// Les valeurs numériques de la trace v3 sont gelées (contrat 6.1) : chaque énumération interne
+// doit coïncider avec la constante publique. Toute divergence fait échouer la compilation.
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::Uplink) == LSIM_TRACE_KIND_UPLINK);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::LinkAdrAns) == LSIM_TRACE_KIND_LINK_ADR_ANS);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::Exclusion) == LSIM_TRACE_KIND_EXCLUSION);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::AdrDecision) == LSIM_TRACE_KIND_ADR_DECISION);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::LinkAdrReq) == LSIM_TRACE_KIND_LINK_ADR_REQ);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::Downlink) == LSIM_TRACE_KIND_DOWNLINK);
+static_assert(static_cast<std::uint8_t>(LoopTraceKind::Apply) == LSIM_TRACE_KIND_APPLY);
+static_assert(static_cast<std::uint8_t>(LoopTraceOrigin::Normative) == LSIM_TRACE_ORIGIN_NORMATIVE);
+static_assert(static_cast<std::uint8_t>(LoopTraceOrigin::SimulatorPolicy) == LSIM_TRACE_ORIGIN_SIMULATOR_POLICY);
+static_assert(static_cast<std::uint8_t>(LoopTraceOrigin::Radio) == LSIM_TRACE_ORIGIN_RADIO);
+static_assert(static_cast<std::uint8_t>(LoopTraceAction::Created) == LSIM_TRACE_ACTION_CREATED);
+static_assert(static_cast<std::uint8_t>(LoopTraceAction::Renewed) == LSIM_TRACE_ACTION_RENEWED);
+static_assert(static_cast<std::uint8_t>(LoopTraceAction::Expired) == LSIM_TRACE_ACTION_EXPIRED);
+static_assert(static_cast<std::uint8_t>(LoopExclusionTarget::DataRate) == LSIM_TRACE_TARGET_DATA_RATE);
+static_assert(static_cast<std::uint8_t>(LoopExclusionTarget::Power) == LSIM_TRACE_TARGET_POWER);
+static_assert(static_cast<std::uint8_t>(LoopExclusionTarget::Channel) == LSIM_TRACE_TARGET_CHANNEL);
+static_assert(static_cast<std::uint8_t>(LoopExclusionTarget::Mask) == LSIM_TRACE_TARGET_MASK);
+static_assert(static_cast<std::uint8_t>(LoopDownlinkLoss::None) == LSIM_TRACE_LOSS_NONE);
+static_assert(static_cast<std::uint8_t>(LoopDownlinkLoss::DeviceTransmitting) == LSIM_TRACE_LOSS_DEVICE_TRANSMITTING);
+static_assert(static_cast<std::uint8_t>(LoopDownlinkLoss::NoGatewaySlot) == LSIM_TRACE_LOSS_NO_GATEWAY_SLOT);
+static_assert(static_cast<std::uint8_t>(LoopDownlinkLoss::BelowSensitivity) == LSIM_TRACE_LOSS_BELOW_SENSITIVITY);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::Ok) == LSIM_TRACE_CHANNEL_REASON_OK);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::RfuCntl) == LSIM_TRACE_CHANNEL_REASON_RFU_CNTL);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::UndefinedChannel) == LSIM_TRACE_CHANNEL_REASON_UNDEFINED_CHANNEL);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::AllDisabled) == LSIM_TRACE_CHANNEL_REASON_ALL_DISABLED);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::IncompatibleWithDataRate) ==
+              LSIM_TRACE_CHANNEL_REASON_INCOMPATIBLE_WITH_DATA_RATE);
+static_assert(static_cast<std::uint8_t>(LoopChannelReason::RfuBits) == LSIM_TRACE_CHANNEL_REASON_RFU_BITS);
+static_assert(static_cast<std::uint8_t>(LoopDataRateReason::Ok) == LSIM_TRACE_DR_REASON_OK);
+static_assert(static_cast<std::uint8_t>(LoopDataRateReason::Ignored) == LSIM_TRACE_DR_REASON_IGNORED);
+static_assert(static_cast<std::uint8_t>(LoopDataRateReason::UnknownDr) == LSIM_TRACE_DR_REASON_UNKNOWN_DR);
+static_assert(static_cast<std::uint8_t>(LoopDataRateReason::NotSupportedByChannels) ==
+              LSIM_TRACE_DR_REASON_NOT_SUPPORTED_BY_CHANNELS);
+static_assert(static_cast<std::uint8_t>(LoopPowerReason::Ok) == LSIM_TRACE_POWER_REASON_OK);
+static_assert(static_cast<std::uint8_t>(LoopPowerReason::Ignored) == LSIM_TRACE_POWER_REASON_IGNORED);
+static_assert(static_cast<std::uint8_t>(LoopPowerReason::Reserved) == LSIM_TRACE_POWER_REASON_RESERVED);
+static_assert(kLoopNoIndex == LSIM_TRACE_NO_INDEX);
+static_assert(kLoopFieldIgnore == LSIM_TRACE_FIELD_IGNORE);
+
+// `status` : bits ACK pour LinkAdrAns et Apply, sentinelle sinon (contrat 6.1).
+std::uint8_t status_field(const LoopTraceEvent& e) {
+    const bool applies = e.kind == LoopTraceKind::LinkAdrAns || e.kind == LoopTraceKind::Apply;
+    return applies ? e.status : static_cast<std::uint8_t>(LSIM_TRACE_STATUS_NONE);
+}
+
+// `downlink` : indice de descente pour LinkAdrReq, Downlink et Apply, sentinelle sinon.
+std::uint32_t downlink_field(const LoopTraceEvent& e) {
+    const bool indexed = e.kind == LoopTraceKind::LinkAdrReq || e.kind == LoopTraceKind::Downlink ||
+                         e.kind == LoopTraceKind::Apply;
+    return indexed ? e.downlink : static_cast<std::uint32_t>(LSIM_TRACE_NO_INDEX);
+}
+
+// `loss` : cause de perte pour Downlink uniquement ; LSIM_TRACE_LOSS_NONE sinon.
+std::uint8_t loss_field(const LoopTraceEvent& e) {
+    return e.kind == LoopTraceKind::Downlink ? e.loss : static_cast<std::uint8_t>(LSIM_TRACE_LOSS_NONE);
+}
+
+}  // namespace
+
+bool is_historical_channel_mode(const lsim_closed_loop_v3_args& args) {
+    return args.channels == nullptr && args.channel_count == 0 && args.channel_plan == LSIM_CHANNEL_PLAN_NONE;
+}
+
+std::vector<LoopChannelConfig> build_channel_configs(const lsim_closed_loop_v3_args& args) {
+    std::vector<LoopChannelConfig> out(args.device_count);
+    const LoopChannelState default_device = loop_eu868_default_channels();
+    const LoopChannelSet default_view = loop_eu868_plan().defaults;
+    for (LoopChannelConfig& cfg : out) {
+        cfg.device = default_device;
+        cfg.server_view = default_view;
+    }
+    if (args.channels == nullptr) return out;
+    for (std::size_t i = 0; i < args.channel_count; ++i) {
+        const lsim_channel_device_v3& element = args.channels[i];
+        if (element.device_index >= args.device_count) continue;  // refusé par la validation
+        if (element.present != LSIM_CHANNEL_PRESENT_YES) continue;  // valeurs par défaut du moteur
+        LoopChannelState device;
+        LoopChannelSet view;
+        for (std::size_t ch = 0; ch < kLoopMaxChannels; ++ch) {
+            device.dr_mask[ch] = element.dr_mask[ch];
+            if (bit_at(element.enabled, ch)) device.enabled.set(ch);
+            if (bit_at(element.server_defined, ch)) view.set(ch);
+        }
+        out[element.device_index].device = device;
+        out[element.device_index].server_view = view;
+    }
+    return out;
+}
+
+std::vector<lsim_loop_trace_v3> convert_trace_v3(const std::vector<LoopTraceEvent>& events) {
+    std::vector<lsim_loop_trace_v3> out;
+    out.reserve(events.size());
+    for (const LoopTraceEvent& e : events) {
+        lsim_loop_trace_v3 o{};  // reserved = 0
+        o.t_ns = e.t_ns;
+        o.device = e.device;
+        o.uplink = e.uplink;
+        o.downlink = downlink_field(e);
+        o.kind = static_cast<std::uint8_t>(e.kind);
+        o.origin = static_cast<std::uint8_t>(e.origin);
+        o.action = static_cast<std::uint8_t>(e.action);
+        o.target = static_cast<std::uint8_t>(e.target);
+        o.loss = loss_field(e);
+        o.status = status_field(e);
+        o.dr = e.dr;
+        o.power_index = e.power_index;
+        o.channel_mask = e.channel_mask;
+        o.value = e.value;
+        o.flag = e.flag ? 1 : 0;
+        o.reason_channel = e.reason_channel;
+        o.reason_dr = e.reason_dr;
+        o.reason_power = e.reason_power;
+        out.push_back(o);
+    }
+    return out;
+}
+
+}  // namespace lsim::sim::abi_v3
diff --git a/core/src/closed_loop_v3_output.cpp b/core/src/closed_loop_v3_output.cpp
new file mode 100644
index 0000000..e92d1dd
--- /dev/null
+++ b/core/src/closed_loop_v3_output.cpp
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: Apache-2.0
+// Écriture atomique des sorties de lsim_simulate_closed_loop_v3 (étape 6.2.5).
+#include "lsim/closed_loop_v3_output.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "lsim/closed_loop_v3_config.hpp"
+#include "lsim/closed_loop_v3_validate.hpp"
+#include "lsim/loop_adr.hpp"
+
+namespace lsim::sim::abi_v3 {
+namespace {
+
+struct Converted {
+    std::vector<lsim_loop_uplink> uplinks;
+    std::vector<lsim_loop_downlink> downlinks;
+    std::vector<lsim_interval> busy;
+    std::vector<lsim_loop_trace_v3> trace;
+    std::vector<lsim_channel_terminal_v3> terminals;
+    std::vector<lsim_device_stats> per_device;
+    lsim_sim_stats totals{};
+    lsim_loop_mac_counters mac{};
+};
+
+// Conversions pures, sans écriture utilisateur. Tout ce qui peut échouer (allocations) a lieu ici.
+Converted convert_all(const lsim_closed_loop_v3_args& a, const EngineOutputs& out) {
+    Converted c;
+    const LoopResult& res = out.result;
+
+    c.uplinks.resize(res.uplinks.size());
+    for (std::size_t k = 0; k < res.uplinks.size(); ++k) {
+        const LoopUplink& u = res.uplinks[k];
+        lsim_loop_uplink& o = c.uplinks[k];
+        o.device_index = u.device;
+        o.start_ns = u.start_ns;
+        o.end_ns = u.end_ns;
+        o.spreading_factor = u.spreading_factor;
+        o.dr = u.dr;
+        o.power_index = u.power_index;
+        o.rssi_dbm = u.rssi_dbm;
+        o.outcome = static_cast<std::uint8_t>(u.outcome);
+        o.answer_mask = u.answer_mask;
+        o.answer_ok = u.answer_ok;
+    }
+
+    c.downlinks.resize(res.downlinks.size());
+    for (std::size_t k = 0; k < res.downlinks.size(); ++k) {
+        const LoopDownlink& d = res.downlinks[k];
+        lsim_loop_downlink& o = c.downlinks[k];
+        o.uplink_index = d.uplink;
+        o.device_index = d.device;
+        o.kind = d.kind;
+        o.commands = d.commands;
+        o.t_open_ns = d.t_open;
+        o.start_ns = d.start_ns;
+        o.air_ns = d.air_ns;
+        o.device_missed = d.device_missed ? 1 : 0;
+        o.delivered = d.delivered ? 1 : 0;
+        o.req_dr = d.req_dr;
+        o.req_power_index = d.req_power_index;
+    }
+
+    c.busy.resize(res.gateway_busy.size());
+    for (std::size_t k = 0; k < res.gateway_busy.size(); ++k) {
+        c.busy[k].start_ns = res.gateway_busy[k].start;
+        c.busy[k].end_ns = res.gateway_busy[k].end;
+    }
+
+    // La trace n'est produite que si trace_enabled == 1 (l'appelant active io.trace_v3 dans ce cas).
+    if (a.trace_enabled == 1) c.trace = convert_trace_v3(out.io.trace);
+
+    c.terminals.resize(out.io.terminals.size());
+    for (std::size_t i = 0; i < out.io.terminals.size(); ++i) {
+        const LoopTerminalRadio& t = out.io.terminals[i];
+        lsim_channel_terminal_v3& o = c.terminals[i];
+        o.struct_size = sizeof(lsim_channel_terminal_v3);
+        o.abi_version = 3;
+        o.device_index = static_cast<std::uint32_t>(i);
+        o.dr = t.dr;
+        o.power_index = t.power_index;
+        o.reserved0 = 0;
+        for (std::size_t ch = 0; ch < kLoopMaxChannels; ++ch) {
+            o.dr_mask[ch] = t.channels.dr_mask[ch];
+            if (t.channels.enabled.test(ch)) {
+                o.enabled[ch / 8U] = static_cast<std::uint8_t>(o.enabled[ch / 8U] | (1U << (ch % 8U)));
+            }
+        }
+        for (std::uint8_t& r : o.reserved1) r = 0;
+    }
+
+    c.per_device.resize(out.per_device.size());
+    for (std::size_t i = 0; i < out.per_device.size(); ++i) {
+        const DeviceStats& s = out.per_device[i];
+        lsim_device_stats& o = c.per_device[i];
+        o.sent = s.sent;
+        o.received = s.received;
+        o.lost_sensitivity = s.lost_sensitivity;
+        o.lost_collision = s.lost_collision;
+        o.airtime_ns = s.airtime_ns;
+        o.lost_gateway_busy = s.lost_gateway_busy;
+    }
+
+    const SimulationStats& tot = out.totals;
+    c.totals.sent = tot.sent;
+    c.totals.received = tot.received;
+    c.totals.lost_sensitivity = tot.lost_sensitivity;
+    c.totals.lost_collision = tot.lost_collision;
+    c.totals.airtime_ns = tot.airtime_ns;
+    c.totals.lost_gateway_busy = tot.lost_gateway_busy;
+    c.totals.gateway_busy_ns = tot.gateway_busy_ns;
+    c.totals.gateway_peak_concurrent = tot.gateway_peak_concurrent;
+    c.totals.observation_ns = tot.observation_ns;
+    c.totals.gateway_utilization = tot.gateway_utilization;
+
+    c.mac.enqueued = res.mac.enqueued;
+    c.mac.dispatched = res.mac.dispatched;
+    c.mac.delivered = res.mac.delivered;
+    c.mac.dispatch_lost = res.mac.dispatch_lost;
+    c.mac.deferred = res.mac.deferred;
+    c.mac.expired = res.mac.expired;
+    c.mac.pending_at_end = res.mac.pending_at_end;
+    return c;
+}
+
+// Compteurs requis : écrits dans tous les cas où la sortie est décidée (succès ou capacité).
+void write_counts(const lsim_closed_loop_v3_args& a, std::size_t up, std::size_t dl, std::size_t busy,
+                  std::size_t trace, std::size_t terminals) {
+    *a.uplink_count = up;
+    *a.downlink_count = dl;
+    *a.busy_count = busy;
+    *a.trace_count = trace;
+    *a.terminal_count = terminals;
+}
+
+}  // namespace
+
+std::int32_t emit_closed_loop_v3(const lsim_closed_loop_v3_args* args, std::int32_t engine_status,
+                                 const EngineOutputs& out) {
+    const std::int32_t valid = validate_closed_loop_v3_args(args);
+    if (valid != 0) return valid;
+    if (engine_status != 0) return engine_status;
+    const lsim_closed_loop_v3_args& a = *args;
+    try {
+        const std::size_t n = a.device_count;
+        if (out.per_device.size() != n || out.io.terminals.size() != n) {
+            return LSIM_STATUS_INTERNAL;
+        }
+        const std::size_t trace_n = a.trace_enabled == 1 ? out.io.trace.size() : 0;
+        const std::size_t up_n = out.result.uplinks.size();
+        const std::size_t dl_n = out.result.downlinks.size();
+        const std::size_t busy_n = out.result.gateway_busy.size();
+
+        // Capacités, dans l'ordre gelé en 6.1. Seuls les compteurs requis sont écrits.
+        if (up_n > a.uplink_capacity) {
+            write_counts(a, up_n, dl_n, busy_n, trace_n, n);
+            return LSIM_STATUS_SIM_BASE + static_cast<std::int32_t>(SimStatus::TraceBufferTooSmall);
+        }
+        if (dl_n > a.downlink_capacity || busy_n > a.busy_capacity) {
+            write_counts(a, up_n, dl_n, busy_n, trace_n, n);
+            return LSIM_STATUS_PLAN_BASE + 4;
+        }
+        if (trace_n > a.trace_capacity) {
+            write_counts(a, up_n, dl_n, busy_n, trace_n, n);
+            return LSIM_STATUS_CHANNEL_TRACE_BUFFER_TOO_SMALL;
+        }
+        if (n > a.terminal_capacity) {
+            write_counts(a, up_n, dl_n, busy_n, trace_n, n);
+            return LSIM_STATUS_CHANNEL_TERMINAL_BUFFER_TOO_SMALL;
+        }
+
+        // Succès : préparer toutes les sorties, puis copier sans échec possible.
+        const Converted c = convert_all(a, out);
+        for (std::size_t k = 0; k < up_n; ++k) a.uplinks[k] = c.uplinks[k];
+        for (std::size_t k = 0; k < dl_n; ++k) a.downlinks[k] = c.downlinks[k];
+        for (std::size_t k = 0; k < busy_n; ++k) a.busy[k] = c.busy[k];
+        for (std::size_t k = 0; k < trace_n; ++k) a.trace[k] = c.trace[k];
+        for (std::size_t k = 0; k < n; ++k) a.terminals[k] = c.terminals[k];
+        for (std::size_t i = 0; i < n; ++i) a.per_device[i] = c.per_device[i];
+        *a.totals = c.totals;
+        if (a.mac_counters != nullptr) *a.mac_counters = c.mac;
+        write_counts(a, up_n, dl_n, busy_n, trace_n, n);
+        return 0;
+    } catch (...) {
+        return LSIM_STATUS_INTERNAL;
+    }
+}
+
+}  // namespace lsim::sim::abi_v3
diff --git a/core/src/closed_loop_v3_validate.cpp b/core/src/closed_loop_v3_validate.cpp
new file mode 100644
index 0000000..d0409b6
--- /dev/null
+++ b/core/src/closed_loop_v3_validate.cpp
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: Apache-2.0
+// Validation des arguments de lsim_simulate_closed_loop_v3 (étape 6.2.2). Aucune écriture dans les
+// sorties ; aucune simulation. Les règles suivent le contrat 6.1 (codes base 1000, sentinelles,
+// buffers) ; les choix d'interprétation sont signalés dans le compte rendu de 6.2.2.
+#include "lsim/closed_loop_v3_validate.hpp"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+#include "lsim/engine.hpp"
+#include "lsim/loop_adr.hpp"
+
+namespace lsim::sim::abi_v3 {
+namespace {
+
+constexpr std::size_t kEnabledBytes = 10;     // 80 bits, LSB first : bit c dans enabled[c / 8]
+constexpr std::size_t kDrMaskBytes = 80;      // un octet par canal
+constexpr std::size_t kReservedBytes = 12;    // lsim_channel_device_v3::reserved
+constexpr std::size_t kSupportedChannels = 16;
+constexpr std::size_t kMaxDrBit = 7;          // bits de DR0..DR7 dans dr_mask
+
+constexpr std::size_t kArgsSize = sizeof(lsim_closed_loop_v3_args);
+constexpr std::size_t kTraceSize = sizeof(lsim_loop_trace_v3);
+constexpr std::size_t kTerminalSize = sizeof(lsim_channel_terminal_v3);
+constexpr std::size_t kChannelSize = sizeof(lsim_channel_device_v3);
+
+// Une plage mémoire non vide : [begin, end).
+struct Span {
+    std::uintptr_t begin = 0;
+    std::uintptr_t end = 0;
+};
+
+bool any_nonzero(const std::uint8_t* bytes, std::size_t count) {
+    for (std::size_t i = 0; i < count; ++i) {
+        if (bytes[i] != 0) return true;
+    }
+    return false;
+}
+
+bool bit_set(const std::uint8_t* bytes, std::size_t channel) {
+    return ((bytes[channel / 8U] >> (channel % 8U)) & 1U) != 0;
+}
+
+// Ajoute une plage après contrôle de débordement et d'alignement. Une plage vide est ignorée.
+// Le pointeur d'une plage non vide doit déjà être non nul (contrôlé par l'appelant).
+std::int32_t add_span(std::array<Span, 32>& spans, std::size_t& count, const void* p, std::size_t elements,
+                      std::size_t element_size, std::size_t alignment) {
+    if (elements == 0) return 0;
+    if (elements > std::numeric_limits<std::size_t>::max() / element_size) {
+        return LSIM_STATUS_CHANNEL_RANGE_OVERFLOW;
+    }
+    const std::size_t bytes = elements * element_size;
+    const auto begin = reinterpret_cast<std::uintptr_t>(p);
+    if (begin > std::numeric_limits<std::uintptr_t>::max() - static_cast<std::uintptr_t>(bytes)) {
+        return LSIM_STATUS_CHANNEL_RANGE_OVERFLOW;
+    }
+    if (begin % alignment != 0) return LSIM_STATUS_CHANNEL_MISALIGNED;
+    spans[count++] = Span{begin, begin + static_cast<std::uintptr_t>(bytes)};
+    return 0;
+}
+
+// Contrôle d'un élément de configuration canal, dans l'ordre : taille, version, index, drapeau
+// present, réservés, champs sans present, indices 16..79, masques de DR, activation, vue serveur.
+std::int32_t check_channel_device(const lsim_channel_device_v3& c, std::size_t device_count,
+                                  std::vector<bool>& seen, const lsim_loop_region* regions) {
+    if (c.struct_size != kChannelSize) return LSIM_STATUS_CHANNEL_ELEMENT_SIZE;
+    if (c.abi_version != kClosedLoopV3AbiVersion) return LSIM_STATUS_CHANNEL_ABI_VERSION;
+    if (c.device_index >= device_count || seen[c.device_index]) return LSIM_STATUS_CHANNEL_DEVICE_INDEX;
+    seen[c.device_index] = true;
+    if (c.present != LSIM_CHANNEL_PRESENT_NO && c.present != LSIM_CHANNEL_PRESENT_YES) {
+        return LSIM_STATUS_CHANNEL_PRESENT_FLAG;
+    }
+    if (any_nonzero(c.reserved, kReservedBytes)) return LSIM_STATUS_CHANNEL_RESERVED_NONZERO;
+    if (c.present == LSIM_CHANNEL_PRESENT_NO) {
+        if (any_nonzero(c.dr_mask, kDrMaskBytes) || any_nonzero(c.enabled, kEnabledBytes) ||
+            any_nonzero(c.server_defined, kEnabledBytes)) {
+            return LSIM_STATUS_CHANNEL_FIELDS_WITHOUT_PRESENT;
+        }
+        return 0;
+    }
+    // Indices 16 à 79 : refusés dans les champs concernés (A1).
+    for (std::size_t ch = kSupportedChannels; ch < kDrMaskBytes; ++ch) {
+        if (c.dr_mask[ch] != 0) return LSIM_STATUS_CHANNEL_INDEX_UNSUPPORTED;
+    }
+    if (any_nonzero(c.enabled + 2, kEnabledBytes - 2) || any_nonzero(c.server_defined + 2, kEnabledBytes - 2)) {
+        return LSIM_STATUS_CHANNEL_INDEX_UNSUPPORTED;
+    }
+    // Chaque bit de DR d'un canal défini doit être inférieur ou égal au max_dr de la région.
+    // Pas de contrôle sur dr_sf : le moteur accepte un bit sans entrée dr_sf (état initial).
+    const lsim_loop_region& region = regions[c.device_index];
+    for (std::size_t ch = 0; ch < kSupportedChannels; ++ch) {
+        const std::uint8_t mask = c.dr_mask[ch];
+        for (std::size_t dr = 0; dr <= kMaxDrBit; ++dr) {
+            if (((mask >> dr) & 1U) == 0) continue;
+            if (dr > region.max_dr) return LSIM_STATUS_CHANNEL_DR_MASK_INVALID;
+        }
+    }
+    // Un canal activé doit être défini (dr_mask non nul).
+    for (std::size_t ch = 0; ch < kSupportedChannels; ++ch) {
+        if (bit_set(c.enabled, ch) && c.dr_mask[ch] == 0) return LSIM_STATUS_CHANNEL_ENABLED_UNDEFINED;
+    }
+    if (!any_nonzero(c.enabled, kEnabledBytes)) return LSIM_STATUS_CHANNEL_ENABLED_EMPTY;
+    if (!any_nonzero(c.server_defined, kEnabledBytes)) return LSIM_STATUS_CHANNEL_SERVER_VIEW_EMPTY;
+    return 0;
+}
+
+std::int32_t validate_body(const lsim_closed_loop_v3_args& a) {
+    // En-tête et tailles déclarées.
+    if (a.struct_size != kArgsSize) return LSIM_STATUS_CHANNEL_ARGS_SIZE;
+    if (a.abi_version != kClosedLoopV3AbiVersion) return LSIM_STATUS_CHANNEL_ABI_VERSION;
+    if (a.trace_element_size != kTraceSize || a.terminal_element_size != kTerminalSize) {
+        return LSIM_STATUS_CHANNEL_ELEMENT_SIZE;
+    }
+    if (a.reserved0 != 0 || a.reserved1 != 0) return LSIM_STATUS_CHANNEL_RESERVED_NONZERO;
+
+    // Plan et mode de configuration des canaux.
+    if (a.channel_plan != LSIM_CHANNEL_PLAN_NONE && a.channel_plan != LSIM_CHANNEL_PLAN_EU868_RP002_1_0_5) {
+        return LSIM_STATUS_CHANNEL_PLAN;
+    }
+    const bool historical = a.channels == nullptr && a.channel_count == 0 && a.channel_plan == LSIM_CHANNEL_PLAN_NONE;
+    const bool explicit_mode = a.channels != nullptr && a.device_count > 0 &&
+                               a.channel_count == a.device_count &&
+                               a.channel_plan == LSIM_CHANNEL_PLAN_EU868_RP002_1_0_5;
+    if (!historical && !explicit_mode) return LSIM_STATUS_CHANNEL_MODE;
+
+    // Trace : mode binaire, buffer interdit quand désactivée (A10), obligatoire quand activée.
+    if (a.trace_enabled != 0 && a.trace_enabled != 1) return LSIM_STATUS_CHANNEL_TRACE_MODE;
+    if (a.trace_enabled == 0 && (a.trace != nullptr || a.trace_capacity != 0)) return LSIM_STATUS_CHANNEL_TRACE_MODE;
+
+    if (a.device_count > kMaxEndDevices) {
+        return LSIM_STATUS_SIM_BASE + static_cast<std::int32_t>(SimStatus::TooManyDevices);
+    }
+
+    // Pointeurs obligatoires.
+    const std::size_t n = a.device_count;
+    if (a.gateway == nullptr || a.prop == nullptr || a.totals == nullptr || a.options == nullptr ||
+        a.uplinks == nullptr || a.downlinks == nullptr || a.busy == nullptr || a.uplink_count == nullptr ||
+        a.downlink_count == nullptr || a.busy_count == nullptr ||
+        a.trace_count == nullptr || a.terminal_count == nullptr) {
+        return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    }
+    if (n > 0 && (a.devices == nullptr || a.radios == nullptr || a.regions == nullptr || a.per_device == nullptr)) {
+        return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    }
+    if (a.mac_count > 0 && a.mac == nullptr) return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    if (a.trace_enabled == 1 && a.trace == nullptr) return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    if (a.terminals == nullptr && a.terminal_capacity > 0) return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    // Capacités de sortie : contrôlées après simulation (closed_loop_v3_output.cpp), dans l'ordre gelé.
+
+    // Plages mémoire : débordements, alignements, puis chevauchements (plages vides ignorées).
+    std::array<Span, 32> spans{};
+    std::size_t span_count = 0;
+    std::int32_t err = 0;
+    auto add = [&](const void* p, std::size_t elements, std::size_t size, std::size_t align) {
+        if (err == 0) err = add_span(spans, span_count, p, elements, size, align);
+    };
+    add(&a, 1, kArgsSize, alignof(lsim_closed_loop_v3_args));
+    add(a.devices, n, sizeof(lsim_end_device), alignof(lsim_end_device));
+    add(a.radios, n, sizeof(lsim_plan_device), alignof(lsim_plan_device));
+    add(a.regions, n, sizeof(lsim_loop_region), alignof(lsim_loop_region));
+    add(a.gateway, 1, sizeof(lsim_gateway_v2), alignof(lsim_gateway_v2));
+    add(a.prop, 1, sizeof(lsim_propagation), alignof(lsim_propagation));
+    add(a.env, a.env != nullptr ? 1 : 0, sizeof(lsim_environment), alignof(lsim_environment));
+    add(a.options, 1, sizeof(lsim_loop_options), alignof(lsim_loop_options));
+    add(a.mac, a.mac_count, sizeof(lsim_loop_mac), alignof(lsim_loop_mac));
+    add(a.channels, a.channel_count, kChannelSize, alignof(lsim_channel_device_v3));
+    add(a.per_device, n, sizeof(lsim_device_stats), alignof(lsim_device_stats));
+    add(a.totals, 1, sizeof(lsim_sim_stats), alignof(lsim_sim_stats));
+    add(a.mac_counters, a.mac_counters != nullptr ? 1 : 0, sizeof(lsim_loop_mac_counters),
+        alignof(lsim_loop_mac_counters));  // facultatif (convention v1/v2)
+    add(a.uplinks, a.uplink_capacity, sizeof(lsim_loop_uplink), alignof(lsim_loop_uplink));
+    add(a.uplink_count, 1, sizeof(std::size_t), alignof(std::size_t));
+    add(a.downlinks, a.downlink_capacity, sizeof(lsim_loop_downlink), alignof(lsim_loop_downlink));
+    add(a.downlink_count, 1, sizeof(std::size_t), alignof(std::size_t));
+    add(a.busy, a.busy_capacity, sizeof(lsim_interval), alignof(lsim_interval));
+    add(a.busy_count, 1, sizeof(std::size_t), alignof(std::size_t));
+    add(a.trace, a.trace_enabled == 1 ? a.trace_capacity : 0, kTraceSize, alignof(lsim_loop_trace_v3));
+    add(a.trace_count, 1, sizeof(std::size_t), alignof(std::size_t));
+    add(a.terminals, a.terminal_capacity, kTerminalSize, alignof(lsim_channel_terminal_v3));
+    add(a.terminal_count, 1, sizeof(std::size_t), alignof(std::size_t));
+    if (err != 0) return err;
+    for (std::size_t i = 0; i < span_count; ++i) {
+        for (std::size_t j = i + 1; j < span_count; ++j) {
+            if (spans[i].begin < spans[j].end && spans[j].begin < spans[i].end) {
+                return LSIM_STATUS_CHANNEL_BUFFERS_ALIASED;
+            }
+        }
+    }
+
+    // Éléments de configuration canal : un par dispositif, chacun une seule fois.
+    if (explicit_mode) {
+        std::vector<bool> seen(n, false);
+        for (std::size_t i = 0; i < n; ++i) {
+            const std::int32_t code = check_channel_device(a.channels[i], n, seen, a.regions);
+            if (code != 0) return code;
+        }
+    }
+    return 0;
+}
+
+}  // namespace
+
+std::int32_t validate_closed_loop_v3_args(const lsim_closed_loop_v3_args* args) {
+    if (args == nullptr) return LSIM_STATUS_CHANNEL_NULL_POINTER;
+    if (reinterpret_cast<std::uintptr_t>(args) % alignof(lsim_closed_loop_v3_args) != 0) {
+        return LSIM_STATUS_CHANNEL_MISALIGNED;
+    }
+    try {
+        return validate_body(*args);
+    } catch (...) {
+        return LSIM_STATUS_INTERNAL;
+    }
+}
+
+}  // namespace lsim::sim::abi_v3
diff --git a/core/src/downlink_plan.cpp b/core/src/downlink_plan.cpp
new file mode 100644
index 0000000..74dc683
--- /dev/null
+++ b/core/src/downlink_plan.cpp
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "lsim/downlink_plan.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+
+#include "lsim/lora_phy.hpp"
+
+namespace lsim::plan {
+namespace {
+
+// Constantes alignées sur `lsim.plan.RECEIVE_DELAY1_US` et `trace_events.RX1_WINDOW_NS`.
+constexpr std::int64_t kReceiveDelay1Ns = 1'000'000'000;
+constexpr std::int64_t kRx1WindowNs = 1'000'000'000;
+// Trame downlink sans charge (MHDR, DevAddr, FCtrl, FCnt, MIC) et avec charge (+ FPort).
+constexpr std::uint32_t kAckFrameBytes = 12;
+constexpr std::uint32_t kDataFrameOverheadBytes = 13;
+constexpr std::uint32_t kMaxDownlinkPayloadBytes = 242;
+
+// Débit RX1 valide : SF 7..12 et largeur 125, 250 ou 500 kHz. Vérifié à la construction, pour que
+// l'erreur porte sur le paramètre radio et non sur une descente planifiée plus tard.
+bool valid_rx1(const DeviceRadio& r) {
+    if (r.rx1_sf < 7 || r.rx1_sf > 12) return false;
+    return r.rx1_bw_hz == 125'000 || r.rx1_bw_hz == 250'000 || r.rx1_bw_hz == 500'000;
+}
+
+Outcome from_uplink(UplinkOutcome o) {
+    switch (o) {
+        case UplinkOutcome::Received: return Outcome::Received;
+        case UplinkOutcome::LostSensitivity: return Outcome::LostSensitivity;
+        case UplinkOutcome::LostCollision: return Outcome::LostCollision;
+        case UplinkOutcome::LostGatewayBusy: return Outcome::LostGatewayBusy;
+    }
+    return Outcome::LostSensitivity;
+}
+
+// Issue du saut montant (`_HOP_OUTCOME` côté Python).
+Outcome hop_from_uplink(UplinkOutcome o) {
+    switch (o) {
+        case UplinkOutcome::Received: return Outcome::Delivered;
+        case UplinkOutcome::LostSensitivity: return Outcome::LostSensitivity;
+        case UplinkOutcome::LostCollision: return Outcome::LostCollision;
+        case UplinkOutcome::LostGatewayBusy: return Outcome::NotListened;
+    }
+    return Outcome::NotListened;
+}
+
+struct Job {
+    std::size_t record = 0;
+    std::uint32_t device = 0;
+    EventKind kind = EventKind::Downlink;  // Ack ou Downlink
+    Outcome content = Outcome::Data;       // issue si reçue
+    std::int64_t t_open = 0;
+    std::int64_t airtime_ns = 0;
+    std::int64_t rx1_hz = 0;
+    bool received = false;
+    bool device_missed = false;
+};
+
+}  // namespace
+
+lora::Status downlink_airtime_ns(const DeviceRadio& radio, std::uint32_t payload_bytes,
+                                 std::int64_t& out_ns) {
+    lora::RadioConfig rc;
+    rc.spreading_factor = radio.rx1_sf;
+    rc.bandwidth = static_cast<lora::Bandwidth>(radio.rx1_bw_hz);
+    if (radio.rx1_bw_hz != 125'000 && radio.rx1_bw_hz != 250'000 && radio.rx1_bw_hz != 500'000) {
+        return lora::Status::InvalidBandwidth;
+    }
+    rc.coding_rate = 1;
+    rc.crc_on = false;
+    rc.explicit_header = true;
+    const double symbol_s = static_cast<double>(1u << radio.rx1_sf) / static_cast<double>(radio.rx1_bw_hz);
+    rc.low_data_rate_optimize = symbol_s > 0.016;
+    const lora::AirtimeResult at = lora::time_on_air(rc, payload_bytes);
+    if (at.status != lora::Status::Ok) return at.status;
+    out_ns = at.nanoseconds;
+    return lora::Status::Ok;
+}
+
+PlanStatus plan_downlinks(const std::vector<UplinkRecord>& uplinks,
+                          const std::vector<DeviceRadio>& radios, const PlanOptions& options,
+                          std::vector<Event>& events, std::vector<Interval>& busy) {
+    events.clear();
+    busy.clear();
+    if (options.downlink_payload_bytes > kMaxDownlinkPayloadBytes) return PlanStatus::InvalidOptions;
+    if (!std::isfinite(options.gateway_tx_power_dbm) || !std::isfinite(options.device_antenna_gain_dbi) ||
+        !std::isfinite(options.device_rx_offset_db)) {
+        return PlanStatus::InvalidOptions;
+    }
+    for (const UplinkRecord& r : uplinks) {
+        if (r.device >= radios.size()) return PlanStatus::InvalidInput;
+    }
+    for (const DeviceRadio& rad : radios) {
+        if (!valid_rx1(rad)) return PlanStatus::InvalidRadio;
+    }
+
+    // Début de l'émission suivante du même dispositif (requête de désoccupation de RX1).
+    constexpr std::int64_t kNone = -1;
+    std::vector<std::int64_t> next_start(uplinks.size(), kNone);
+    std::vector<std::int64_t> last_of(radios.size(), kNone);  // indice du dernier enregistrement
+    for (std::size_t i = 0; i < uplinks.size(); ++i) {
+        const std::int64_t prev = last_of[uplinks[i].device];
+        if (prev != kNone) next_start[static_cast<std::size_t>(prev)] = uplinks[i].start_ns;
+        last_of[uplinks[i].device] = static_cast<std::int64_t>(i);
+    }
+
+    // Jobs : une réponse par uplink reçu, dans l'ordre de la trace (`_downlink_jobs`).
+    std::vector<Job> jobs;
+    std::vector<std::int64_t> job_of(uplinks.size(), kNone);
+    std::vector<std::uint32_t> accepted(radios.size(), 0);
+    for (std::size_t i = 0; i < uplinks.size(); ++i) {
+        const UplinkRecord& r = uplinks[i];
+        if (r.outcome != UplinkOutcome::Received) continue;
+        const DeviceRadio& radio = radios[r.device];
+        ++accepted[r.device];
+        const bool queued = options.downlink_every > 0 && accepted[r.device] % options.downlink_every == 0;
+        Job job;
+        std::uint32_t base = 0;
+        if (queued) {
+            job.kind = EventKind::Downlink;
+            job.content = options.confirmed_uplinks ? Outcome::DataAck : Outcome::Data;
+            base = kDataFrameOverheadBytes + options.downlink_payload_bytes;
+        } else if (options.confirmed_uplinks) {
+            job.kind = EventKind::Ack;
+            job.content = Outcome::AckOnly;
+            base = kAckFrameBytes;
+        } else {
+            continue;
+        }
+        job.record = i;
+        job.device = r.device;
+        job.t_open = r.end_ns + kReceiveDelay1Ns;
+        job.rx1_hz = radio.rx1_hz;
+        if (downlink_airtime_ns(radio, base, job.airtime_ns) != lora::Status::Ok) {
+            return PlanStatus::InvalidRadio;
+        }
+        // Réciprocité : RSSI descendant = RSSI montant - P_dev + P_gw + G_dev.
+        const double rssi_dl = r.rssi_dbm - radio.tx_power_dbm + options.gateway_tx_power_dbm +
+                               options.device_antenna_gain_dbi;
+        double sens = 0.0;
+        if (lora::receiver_sensitivity_dbm(radio.rx1_sf, static_cast<lora::Bandwidth>(radio.rx1_bw_hz),
+                                           sens) != lora::Status::Ok) {
+            return PlanStatus::InvalidRadio;
+        }
+        job.received = rssi_dl >= sens + options.device_rx_offset_db;
+        const std::int64_t nxt = next_start[i];
+        job.device_missed = nxt != kNone && nxt < job.t_open + kRx1WindowNs;
+        job_of[i] = static_cast<std::int64_t>(jobs.size());
+        jobs.push_back(job);
+    }
+
+    // Planification passerelle (`_schedule_gateway`) : ordre (t_open, indice de job).
+    std::vector<std::size_t> order(jobs.size());
+    for (std::size_t k = 0; k < order.size(); ++k) order[k] = k;
+    std::stable_sort(order.begin(), order.end(), [&jobs](std::size_t a, std::size_t b) {
+        return jobs[a].t_open < jobs[b].t_open;
+    });
+    std::vector<std::int64_t> starts(jobs.size(), kNone);
+    bool any_busy = false;
+    std::int64_t busy_until = 0;
+    for (std::size_t k : order) {
+        const Job& job = jobs[k];
+        const std::int64_t start = any_busy ? std::max(job.t_open, busy_until) : job.t_open;
+        if (start - job.t_open >= kRx1WindowNs) continue;  // passerelle indisponible dans la RX1
+        starts[k] = start;
+        busy_until = start + job.airtime_ns;
+        any_busy = true;
+        busy.push_back(Interval{start, busy_until});
+    }
+
+    // Événements (`_events`) : ordre d'insertion = enregistrement, puis job ; tri stable par temps.
+    struct Pending {
+        std::int64_t t;
+        Event ev;
+    };
+    std::vector<Pending> pending;
+    pending.reserve(uplinks.size() + jobs.size());
+    for (std::size_t i = 0; i < uplinks.size(); ++i) {
+        const UplinkRecord& r = uplinks[i];
+        const DeviceRadio& radio = radios[r.device];
+        Pending up;
+        up.t = r.start_ns;
+        up.ev.t_ns = r.start_ns;
+        up.ev.device = r.device;
+        up.ev.kind = EventKind::Uplink;
+        up.ev.outcome = from_uplink(r.outcome);
+        Hop h;
+        h.dir = HopDir::DevToGw;
+        h.outcome = hop_from_uplink(r.outcome);
+        h.has_rssi = true;
+        h.rssi_dbm = r.rssi_dbm;
+        h.t_ns = r.start_ns;
+        h.freq_hz = radio.freq_hz;
+        h.dr = radio.dr;
+        up.ev.hops.push_back(h);
+        if (r.outcome == UplinkOutcome::Received) {
+            Hop ns;
+            ns.dir = HopDir::GwToNs;
+            ns.outcome = Outcome::Delivered;
+            ns.t_ns = r.end_ns;
+            ns.freq_hz = radio.freq_hz;
+            ns.dr = radio.dr;
+            up.ev.hops.push_back(ns);
+        }
+        pending.push_back(std::move(up));
+
+        const std::int64_t k = job_of[i];
+        if (k == kNone) continue;
+        const Job& job = jobs[static_cast<std::size_t>(k)];
+        const std::int64_t start = starts[static_cast<std::size_t>(k)];
+        Pending ev;
+        ev.t = job.t_open;
+        ev.ev.device = job.device;
+        if (start == kNone) {
+            ev.ev.t_ns = job.t_open;
+            ev.ev.kind = EventKind::RxWindowMissed;
+            ev.ev.outcome = Outcome::GatewayBusy;
+            Hop hop;
+            hop.dir = HopDir::GwToDev;
+            hop.outcome = Outcome::NotListened;
+            hop.t_ns = job.t_open;
+            hop.freq_hz = job.rx1_hz;
+            ev.ev.hops.push_back(hop);
+        } else if (job.device_missed) {
+            ev.ev.t_ns = job.t_open;
+            ev.ev.kind = EventKind::RxWindowMissed;
+            ev.ev.outcome = Outcome::DeviceTransmitting;
+            Hop hop;
+            hop.dir = HopDir::GwToDev;
+            hop.outcome = Outcome::NotListened;
+            hop.t_ns = start;
+            hop.freq_hz = job.rx1_hz;
+            ev.ev.hops.push_back(hop);
+        } else {
+            ev.ev.t_ns = start;
+            ev.ev.kind = job.kind;
+            ev.ev.outcome = job.received ? job.content : Outcome::LostSensitivity;
+            Hop hop;
+            hop.dir = HopDir::GwToDev;
+            hop.outcome = job.received ? Outcome::Delivered : Outcome::LostSensitivity;
+            hop.t_ns = start;
+            hop.freq_hz = job.rx1_hz;
+            ev.ev.hops.push_back(hop);
+            ev.t = start;
+        }
+        pending.push_back(std::move(ev));
+    }
+    std::stable_sort(pending.begin(), pending.end(),
+                     [](const Pending& a, const Pending& b) { return a.t < b.t; });
+    events.reserve(pending.size());
+    for (Pending& p : pending) events.push_back(std::move(p.ev));
+    return PlanStatus::Ok;
+}
+
+}  // namespace lsim::plan
+
+namespace lsim::plan {
+
+DownlinkScheduler::DownlinkScheduler(const std::vector<DeviceRadio>& radios, const PlanOptions& options)
+    : options_(options), accepted_(radios.size(), 0), ack_air_(radios.size(), 0),
+      data_air_(radios.size(), 0) {
+    if (options.downlink_payload_bytes > kMaxDownlinkPayloadBytes) {
+        status_ = PlanStatus::InvalidOptions;
+        return;
+    }
+    if (!std::isfinite(options.gateway_tx_power_dbm) || !std::isfinite(options.device_antenna_gain_dbi) ||
+        !std::isfinite(options.device_rx_offset_db)) {
+        status_ = PlanStatus::InvalidOptions;
+        return;
+    }
+    for (const DeviceRadio& rad : radios) {
+        if (!valid_rx1(rad)) {
+            status_ = PlanStatus::InvalidRadio;
+            return;
+        }
+    }
+    // Durées de trame : calculées à la première utilisation (comme `plan_downlinks`, une erreur
+    // n'est signalée que si une descente est réellement planifiée).
+    radios_ = radios;
+}
+
+std::optional<Interval> DownlinkScheduler::on_received(std::uint32_t device, std::int64_t end_ns) {
+    if (status_ != PlanStatus::Ok) return std::nullopt;
+    ++accepted_[device];
+    const bool queued = options_.downlink_every > 0 && accepted_[device] % options_.downlink_every == 0;
+    std::uint32_t base = 0;
+    if (queued) {
+        base = kDataFrameOverheadBytes + options_.downlink_payload_bytes;
+    } else if (options_.confirmed_uplinks) {
+        base = kAckFrameBytes;
+    } else {
+        return std::nullopt;
+    }
+    std::int64_t& air = queued ? data_air_[device] : ack_air_[device];
+    if (air == 0 && downlink_airtime_ns(radios_[device], base, air) != lora::Status::Ok) {
+        status_ = PlanStatus::InvalidRadio;
+        return std::nullopt;
+    }
+    const std::int64_t t_open = end_ns + kReceiveDelay1Ns;
+    const std::int64_t start = any_busy_ ? std::max(t_open, busy_until_) : t_open;
+    if (start - t_open >= kRx1WindowNs) return std::nullopt;  // passerelle indisponible dans la RX1
+    any_busy_ = true;
+    busy_until_ = start + air;
+    return Interval{start, busy_until_};
+}
+
+}  // namespace lsim::plan
diff --git a/core/src/loop_adr.cpp b/core/src/loop_adr.cpp
new file mode 100644
index 0000000..bff8343
--- /dev/null
+++ b/core/src/loop_adr.cpp
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: Apache-2.0
+// Canaux, LinkADRReq et LinkADRAns (voir loop_adr.hpp pour les sources et les règles).
+#include "lsim/loop_adr.hpp"
+
+namespace lsim::sim {
+
+namespace {
+
+constexpr std::size_t kWordBits = 64;
+
+std::uint64_t bit_of(std::size_t channel) {
+    return std::uint64_t{1} << (channel % kWordBits);
+}
+
+// Évaluation commune à la validation et à l'application : un seul chemin de calcul.
+LoopLinkAdrDiagnosis evaluate(const LoopRegionalPlan& plan, const LoopTerminalRadio& current,
+                              const LoopLinkAdrRequest& req, LoopChannelSet& resulting) {
+    LoopLinkAdrDiagnosis d;
+    resulting = current.channels.enabled;
+
+    // 1. Masque : portée (affected) et activation (enable) selon ChMaskCntl.
+    LoopChannelSet affected;
+    LoopChannelSet enable;
+    bool mask_valid = true;
+    const std::size_t max_ch = plan.max_channels < kLoopMaxChannels ? plan.max_channels
+                                                                   : kLoopMaxChannels;
+    if (req.ch_mask_cntl == 7) {
+        d.channel_reason = LoopChannelReason::RfuCntl;
+        mask_valid = false;
+    } else if (req.ch_mask_cntl == 5 && (req.ch_mask & 0xFC00U) != 0) {
+        // Bits 10 à 15 RFU non nuls : refus (jamais d'application silencieuse d'un masque douteux).
+        d.channel_reason = LoopChannelReason::RfuBits;
+        mask_valid = false;
+    } else if (req.ch_mask_cntl == 6) {
+        // Tous les canaux définis ON ; le champ ChMask est ignoré (RP002 Table 14).
+        for (std::size_t c = 0; c < max_ch; ++c) {
+            if (current.channels.defined(c)) {
+                affected.set(c);
+                enable.set(c);
+            }
+        }
+    } else if (req.ch_mask_cntl <= 4) {
+        // Blocs de 16 canaux ; chaque bit du masque active un canal du bloc. Les canaux du
+        // bloc non activés sont désactivés.
+        const std::size_t base = static_cast<std::size_t>(req.ch_mask_cntl) * 16U;
+        for (std::size_t i = 0; i < 16U; ++i) {
+            const std::size_t c = base + i;
+            if (c >= max_ch) break;
+            affected.set(c);
+            if ((req.ch_mask >> i) & 1U) enable.set(c);
+        }
+    } else {
+        // ChMaskCntl 5 : 10 bits, banques de 8 canaux (RP002 Table 14). Les bits 10 à 15 sont
+        // RFU : leur présence a été refusée ci-dessus.
+        for (std::size_t b = 0; b < 10U; ++b) {
+            for (std::size_t i = 0; i < 8U; ++i) {
+                const std::size_t c = b * 8U + i;
+                if (c >= max_ch) break;
+                affected.set(c);
+                if ((req.ch_mask >> b) & 1U) enable.set(c);
+            }
+        }
+    }
+
+    if (mask_valid) {
+        // 2. Activation d'un canal non défini : refus, les canaux concernés sont attribués.
+        for (std::size_t c = 0; c < kLoopMaxChannels; ++c) {
+            if (enable.test(c) && !current.channels.defined(c)) d.refused_channels.set(c);
+        }
+        if (d.refused_channels.any()) {
+            d.channel_reason = LoopChannelReason::UndefinedChannel;
+            mask_valid = false;
+        }
+    }
+
+    if (mask_valid) {
+        // État résultant : canaux hors portée inchangés, portée = activations définies.
+        LoopChannelSet next;
+        for (std::size_t w = 0; w < next.words.size(); ++w) {
+            next.words[w] = (current.channels.enabled.words[w] & ~affected.words[w]) |
+                            enable.words[w];
+        }
+        resulting = next;
+        if (!resulting.any()) {
+            d.channel_reason = LoopChannelReason::AllDisabled;
+            mask_valid = false;
+        }
+    }
+
+    // Ensemble utilisé pour évaluer le débit : résultant si le masque est valide, courant sinon.
+    const LoopChannelSet& dr_set = mask_valid ? resulting : current.channels.enabled;
+
+    // 3. Débit. `dr_known` : le débit est connu du plan (ou ignoré, donc le débit courant).
+    std::uint8_t effective_dr = current.dr;
+    bool dr_known = true;
+    if (req.dr == kLoopFieldIgnore) {
+        d.dr_reason = LoopDataRateReason::Ignored;
+    } else if (req.dr > plan.max_dr || ((plan.dr_available >> req.dr) & 1U) == 0) {
+        d.dr_reason = LoopDataRateReason::UnknownDr;
+        d.refuse_dr = true;
+        dr_known = false;
+    } else {
+        effective_dr = req.dr;
+        if (!current.channels.supports_dr(dr_set, req.dr)) {
+            d.dr_reason = LoopDataRateReason::NotSupportedByChannels;
+            d.refuse_dr = true;
+        } else {
+            d.dr_reason = LoopDataRateReason::Ok;
+        }
+    }
+
+    // 4. Compatibilité du masque avec le débit résultant (TS001 Table 23). Attribution D5 :
+    // le débit demandé est déjà marqué ci-dessus ; si le débit est ignoré, le masque est en
+    // cause et le débit courant n'est pas exclu. Un débit inconnu n'est pas comparé.
+    if (mask_valid && dr_known && !current.channels.supports_dr(resulting, effective_dr)) {
+        d.channel_reason = LoopChannelReason::IncompatibleWithDataRate;
+        mask_valid = false;
+    }
+
+    // 5. Puissance : 0xF ignoré ; index réservés au-delà du plan (RP002 Table 13).
+    if (req.power_index == kLoopFieldIgnore) {
+        d.power_reason = LoopPowerReason::Ignored;
+    } else if (req.power_index > plan.max_power_index) {
+        d.power_reason = LoopPowerReason::Reserved;
+        d.refuse_power = true;
+    } else {
+        d.power_reason = LoopPowerReason::Ok;
+    }
+
+    d.status.channel_mask_ack = mask_valid;
+    d.status.data_rate_ack = d.dr_reason == LoopDataRateReason::Ok ||
+                             d.dr_reason == LoopDataRateReason::Ignored;
+    d.status.power_ack = d.power_reason == LoopPowerReason::Ok ||
+                         d.power_reason == LoopPowerReason::Ignored;
+    return d;
+}
+
+}  // namespace
+
+bool LoopChannelSet::operator==(const LoopChannelSet& other) const {
+    return words == other.words;
+}
+
+bool LoopChannelState::operator==(const LoopChannelState& other) const {
+    return dr_mask == other.dr_mask && enabled == other.enabled;
+}
+
+bool LoopTerminalRadio::operator==(const LoopTerminalRadio& other) const {
+    return channels == other.channels && dr == other.dr && power_index == other.power_index;
+}
+
+bool LoopAdrStatus::operator==(const LoopAdrStatus& other) const {
+    return channel_mask_ack == other.channel_mask_ack && data_rate_ack == other.data_rate_ack &&
+           power_ack == other.power_ack;
+}
+
+bool LoopChannelSet::test(std::size_t channel) const {
+    if (channel >= kLoopMaxChannels) return false;
+    return (words[channel / kWordBits] & bit_of(channel)) != 0;
+}
+
+void LoopChannelSet::set(std::size_t channel) {
+    if (channel >= kLoopMaxChannels) return;
+    words[channel / kWordBits] |= bit_of(channel);
+}
+
+void LoopChannelSet::reset(std::size_t channel) {
+    if (channel >= kLoopMaxChannels) return;
+    words[channel / kWordBits] &= ~bit_of(channel);
+}
+
+bool LoopChannelSet::any() const {
+    return words[0] != 0 || words[1] != 0;
+}
+
+std::size_t LoopChannelSet::count() const {
+    std::size_t n = 0;
+    for (std::size_t c = 0; c < kLoopMaxChannels; ++c) {
+        if (test(c)) ++n;
+    }
+    return n;
+}
+
+bool LoopChannelState::defined(std::size_t channel) const {
+    return channel < kLoopMaxChannels && dr_mask[channel] != 0;
+}
+
+LoopChannelSet LoopChannelState::defined_set() const {
+    LoopChannelSet out;
+    for (std::size_t c = 0; c < kLoopMaxChannels; ++c) {
+        if (defined(c)) out.set(c);
+    }
+    return out;
+}
+
+bool LoopChannelState::supports_dr(const LoopChannelSet& set, std::uint8_t dr) const {
+    if (dr > kLoopEuMaxDr) return false;
+    const auto bit = static_cast<std::uint8_t>(std::uint8_t{1} << dr);
+    for (std::size_t c = 0; c < kLoopMaxChannels; ++c) {
+        if (set.test(c) && defined(c) && (dr_mask[c] & bit) != 0) return true;
+    }
+    return false;
+}
+
+LoopRegionalPlan loop_eu868_plan() {
+    LoopRegionalPlan plan;
+    plan.defaults.set(0);  // 868.1 MHz
+    plan.defaults.set(1);  // 868.3 MHz
+    plan.defaults.set(2);  // 868.5 MHz
+    plan.default_dr_mask = 0x3F;  // DR0..DR5
+    plan.max_dr = kLoopEuMaxDr;
+    plan.max_power_index = kLoopEuMaxPowerIndex;
+    plan.max_channels = kLoopMaxChannels;
+    return plan;
+}
+
+bool LoopExclusions::exclude_dr(std::uint8_t value) {
+    if (value >= dr.size()) return false;
+    const bool renewed = dr[value] > 0;
+    dr[value] = kLoopExclusionUplinks;
+    return renewed;
+}
+
+bool LoopExclusions::exclude_power(std::uint8_t value) {
+    if (value >= power.size()) return false;
+    const bool renewed = power[value] > 0;
+    power[value] = kLoopExclusionUplinks;
+    return renewed;
+}
+
+bool LoopExclusions::exclude_mask(std::uint16_t block0) {
+    const bool renewed = mask > 0 && mask_value == block0;
+    mask_value = block0;
+    mask = kLoopExclusionUplinks;
+    return renewed;
+}
+
+bool LoopExclusions::mask_excluded(std::uint16_t block0) const {
+    return mask > 0 && mask_value == block0;
+}
+
+std::uint16_t loop_request_block0(const LoopChannelSet& view, const LoopExclusions& excl,
+                                  const LoopChannelSet& confirmed) {
+    LoopChannelSet cand;
+    for (std::size_t c = 0; c < 16U; ++c) {
+        if (view.test(c) && !excl.channel_excluded(c)) cand.set(c);
+    }
+    const auto block0 = [](const LoopChannelSet& s) {
+        return static_cast<std::uint16_t>(s.words[0] & 0xFFFFU);
+    };
+    const std::uint16_t bits = block0(cand);
+    if (bits == 0 || excl.mask_excluded(bits)) return block0(confirmed);
+    return bits;
+}
+
+bool LoopExclusions::exclude_channel(std::size_t channel_index) {
+    if (channel_index >= channel.size()) return false;
+    const bool renewed = channel[channel_index] > 0;
+    channel[channel_index] = kLoopExclusionUplinks;
+    return renewed;
+}
+
+void LoopExclusions::tick(std::vector<LoopExpiry>* expired) {
+    const auto step = [expired](std::uint16_t& c, LoopExclusionTarget target, std::size_t index) {
+        if (c == 0) return;
+        --c;
+        if (c == 0 && expired != nullptr) {
+            expired->push_back(LoopExpiry{target, static_cast<std::uint16_t>(index)});
+        }
+    };
+    for (std::size_t i = 0; i < dr.size(); ++i) step(dr[i], LoopExclusionTarget::DataRate, i);
+    for (std::size_t i = 0; i < power.size(); ++i) step(power[i], LoopExclusionTarget::Power, i);
+    for (std::size_t i = 0; i < channel.size(); ++i) step(channel[i], LoopExclusionTarget::Channel, i);
+    if (mask > 0) {
+        --mask;
+        if (mask == 0 && expired != nullptr) {
+            expired->push_back(LoopExpiry{LoopExclusionTarget::Mask, mask_value});
+        }
+    }
+}
+
+bool LoopExclusions::dr_excluded(std::uint8_t value) const { return value < dr.size() && dr[value] > 0; }
+
+bool LoopExclusions::power_excluded(std::uint8_t value) const { return value < power.size() && power[value] > 0; }
+
+bool LoopExclusions::channel_excluded(std::size_t channel_index) const {
+    return channel_index < channel.size() && channel[channel_index] > 0;
+}
+
+LoopChannelState loop_eu868_default_channels() {
+    LoopChannelState st;
+    const LoopRegionalPlan plan = loop_eu868_plan();
+    for (std::size_t c = 0; c < kLoopMaxChannels; ++c) {
+        if (plan.defaults.test(c)) {
+            st.dr_mask[c] = plan.default_dr_mask;
+            st.enabled.set(c);
+        }
+    }
+    return st;
+}
+
+std::uint8_t LoopAdrStatus::to_wire() const {
+    std::uint8_t out = 0;
+    if (channel_mask_ack) out = static_cast<std::uint8_t>(out | 0x01U);  // bit 0
+    if (data_rate_ack) out = static_cast<std::uint8_t>(out | 0x02U);     // bit 1
+    if (power_ack) out = static_cast<std::uint8_t>(out | 0x04U);         // bit 2
+    return out;
+}
+
+LoopAdrStatus LoopAdrStatus::from_wire(std::uint8_t status) {
+    LoopAdrStatus s;
+    s.channel_mask_ack = (status & 0x01U) != 0;
+    s.data_rate_ack = (status & 0x02U) != 0;
+    s.power_ack = (status & 0x04U) != 0;
+    return s;
+}
+
+LoopLinkAdrDiagnosis loop_validate_link_adr(const LoopRegionalPlan& plan,
+                                            const LoopTerminalRadio& current,
+                                            const LoopLinkAdrRequest& request) {
+    LoopChannelSet resulting;
+    return evaluate(plan, current, request, resulting);
+}
+
+LoopLinkAdrDiagnosis loop_apply_link_adr(const LoopRegionalPlan& plan, LoopTerminalRadio& terminal,
+                                         const LoopLinkAdrRequest& request) {
+    LoopChannelSet resulting;
+    const LoopLinkAdrDiagnosis d = evaluate(plan, terminal, request, resulting);
+    if (!d.status.all()) return d;  // atomicité : aucun paramètre n'est appliqué
+    terminal.channels.enabled = resulting;
+    if (request.dr != kLoopFieldIgnore) terminal.dr = request.dr;
+    if (request.power_index != kLoopFieldIgnore) terminal.power_index = request.power_index;
+    return d;
+}
+
+}  // namespace lsim::sim
