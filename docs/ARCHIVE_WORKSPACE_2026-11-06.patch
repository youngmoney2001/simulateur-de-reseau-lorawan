+LIB.lsim_plan_downlinks_v1.restype = ctypes.c_int32
+LIB.lsim_plan_downlinks_v1.argtypes = [
+    ctypes.POINTER(_CPlanUplink), ctypes.c_size_t, ctypes.POINTER(_CPlanDevice), ctypes.c_size_t,
+    ctypes.POINTER(_CPlanOptions), ctypes.POINTER(_CPlanEvent), ctypes.c_size_t,
+    ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_CInterval), ctypes.c_size_t,
+    ctypes.POINTER(ctypes.c_size_t),
+]
+
+
+LIB.lsim_simulate_uplinks_causal_v1.restype = ctypes.c_int32
+LIB.lsim_simulate_uplinks_causal_v1.argtypes = [
+    ctypes.POINTER(_CEndDevice), ctypes.c_size_t, ctypes.POINTER(_CGateway),
+    ctypes.POINTER(_CPropagation), ctypes.POINTER(_CEnvironment),
+    ctypes.POINTER(_CDeviceStats), ctypes.POINTER(_CSimStats),
+    ctypes.POINTER(_CTxRecord), ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t),
+    ctypes.POINTER(_CPlanDevice), ctypes.POINTER(_CPlanOptions),
+    ctypes.POINTER(_CInterval), ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t),
+]
+LIB.lsim_simulate_uplinks_causal_gw2.restype = ctypes.c_int32
+LIB.lsim_simulate_uplinks_causal_gw2.argtypes = [
+    ctypes.POINTER(_CEndDevice), ctypes.c_size_t, ctypes.POINTER(_CGatewayV2),
+    ctypes.POINTER(_CPropagation), ctypes.POINTER(_CEnvironment),
+    ctypes.POINTER(_CDeviceStats), ctypes.POINTER(_CSimStats),
+    ctypes.POINTER(_CTxRecord), ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t),
+    ctypes.POINTER(_CPlanDevice), ctypes.POINTER(_CPlanOptions),
+    ctypes.POINTER(_CInterval), ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t),
+]
+
+
+def simulate_causal(devices, gateway, propagation, environment, radios, options):
+    """Boucle fermée causale (S1) : trace et occupation passerelle, en une seule exécution.
+
+    Chaque trame reçue planifie sa descente à sa fin (`lsim_simulate_uplinks_causal_v1`). Renvoie
+    `(TraceResult, occupation)`. Lève `StatusError` si le cœur refuse l'entrée.
+    `devices` et `radios` : même ordre (un `DeviceRadio` par dispositif). Pas de MAC ni de jointure.
+    """
+    n = len(devices)
+    if n > MAX_END_DEVICES:
+        raise ValueError(f"au plus {MAX_END_DEVICES} dispositifs par simulation")
+    if len(radios) != n:
+        raise ValueError("un paramètre radio par dispositif")
+    for r in radios:
+        # Descente vers un débit hors 7..12 (SF5, DR13) : sensibilité du dispositif NV, refus explicite.
+        if not 7 <= r.rx1_sf <= 12:
+            raise SensitivityError(f"descente vers RX1 SF{r.rx1_sf} refusée : sensibilité du "
+                                   "dispositif NV (SF5 : uplink seulement)")
+    capacity = sum(d.messages for d in devices)
+    if capacity > MAX_TRACE_RECORDS:
+        raise ValueError(f"trace limitée à {MAX_TRACE_RECORDS} émissions par simulation")
+    c_devs = _c_end_devices(devices)
+    absolute = getattr(gateway, "absolute_sensitivity", None)
+    c_gw = (absolute.to_c(gateway) if absolute is not None
+            else _CGateway(gateway.x_m, gateway.y_m, gateway.antenna_gain_dbi))
+    c_prop = _CPropagation(propagation.frequency_hz, propagation.reference_distance_m,
+                           propagation.exponent, propagation.capture_threshold_db,
+                           propagation.shadowing_sigma_db, propagation.shadowing_seed)
+    c_stats = (_CDeviceStats * n)()
+    c_tot = _CSimStats()
+    keep: list[object] = []
+    if environment is None:
+        c_env_ref = None
+    else:
+        c_env_struct, keep = _c_environment(environment)
+        c_env_ref = ctypes.byref(c_env_struct)
+    c_radios = (_CPlanDevice * max(1, n))()
+    for i, d in enumerate(radios):
+        c_radios[i].freq_hz = d.freq_hz
+        c_radios[i].dr = -1 if d.dr is None else d.dr
+        c_radios[i].rx1_hz = d.rx1_hz
+        c_radios[i].tx_power_dbm = d.tx_power_dbm
+        c_radios[i].rx1_sf = d.rx1_sf
+        c_radios[i].rx1_bw_hz = d.rx1_bw_hz
+    c_opt = _CPlanOptions(1 if options.confirmed_uplinks else 0, options.downlink_every,
+                          options.downlink_payload_bytes, options.gateway_tx_power_dbm,
+                          options.device_antenna_gain_dbi, options.device_rx_offset_db)
+    records = (_CTxRecord * max(1, capacity))()
+    # Occupation passerelle : au plus une période par trame reçue (une descente au plus).
+    cap_busy = max(1, capacity)
+    count = ctypes.c_size_t(0)
+    n_busy = ctypes.c_size_t(0)
+    busy = (_CInterval * cap_busy)()
+    causal_fn = (LIB.lsim_simulate_uplinks_causal_gw2 if absolute is not None
+                 else LIB.lsim_simulate_uplinks_causal_v1)
+    status = causal_fn(
+        c_devs if n else None, n, ctypes.byref(c_gw), ctypes.byref(c_prop), c_env_ref,
+        c_stats if n else None, ctypes.byref(c_tot), records, capacity, ctypes.byref(count),
+        c_radios if n else None, ctypes.byref(c_opt), busy, cap_busy, ctypes.byref(n_busy))
+    del keep
+    if status != 0:
+        raise StatusError(status)
+    per = tuple(
+        Counters(s.sent, s.received, s.lost_sensitivity, s.lost_collision, s.airtime_ns,
+                 s.lost_gateway_busy)
+        for s in c_stats
+    )
+    tot = Counters(c_tot.sent, c_tot.received, c_tot.lost_sensitivity, c_tot.lost_collision,
+                   c_tot.airtime_ns, c_tot.lost_gateway_busy)
+    load = GatewayLoad(c_tot.gateway_busy_ns, c_tot.gateway_peak_concurrent,
+                       c_tot.observation_ns, c_tot.gateway_utilization)
+    trace = tuple(
+        TxRecord(r.device_index, r.start_ns, r.end_ns, r.spreading_factor, r.rssi_dbm, r.outcome)
+        for r in records[:count.value]
+    )
+    occupation = tuple((busy[k].start_ns, busy[k].end_ns) for k in range(n_busy.value))
+    return TraceResult(per, tot, load, trace), occupation
+
+
+def plan_native(records, radios, options) -> tuple[tuple[ProtocolEvent, ...], tuple[tuple[int, int], ...]]:
+    """Événements et occupation passerelle, calculés en natif à partir de la trace et des radios.
+
+    `records` : `TxRecord` de la trace ; `radios` : `DeviceRadio` ; `options` : `ProtocolOptions`.
+    Lève ValueError pour une entrée refusée par le cœur.
+    """
+    ups = (_CPlanUplink * max(1, len(records)))()
+    for i, r in enumerate(records):
+        ups[i].device_index = r.device_index
+        ups[i].start_ns = r.start_ns
+        ups[i].end_ns = r.end_ns
+        ups[i].spreading_factor = r.spreading_factor
+        ups[i].outcome = _TX_TO_UPLINK[r.outcome]
+        ups[i].rssi_dbm = r.rssi_dbm
+    devs = (_CPlanDevice * max(1, len(radios)))()
+    for i, d in enumerate(radios):
+        devs[i].freq_hz = d.freq_hz
+        devs[i].dr = -1 if d.dr is None else d.dr
+        devs[i].rx1_hz = d.rx1_hz
+        devs[i].tx_power_dbm = d.tx_power_dbm
+        devs[i].rx1_sf = d.rx1_sf
+        devs[i].rx1_bw_hz = d.rx1_bw_hz
+    opt = _CPlanOptions(1 if options.confirmed_uplinks else 0, options.downlink_every,
+                        options.downlink_payload_bytes, options.gateway_tx_power_dbm,
+                        options.device_antenna_gain_dbi, options.device_rx_offset_db)
+    cap_ev = max(4, 2 * len(records) + 2 * len(records))
+    cap_busy = max(4, len(records) + 1)
+    for _ in range(2):
+        evs = (_CPlanEvent * cap_ev)()
+        busy = (_CInterval * cap_busy)()
+        n_ev = ctypes.c_size_t(0)
+        n_busy = ctypes.c_size_t(0)
+        status = LIB.lsim_plan_downlinks_v1(ups, len(records), devs, len(radios), ctypes.byref(opt),
+                                            evs, cap_ev, ctypes.byref(n_ev), busy, cap_busy,
+                                            ctypes.byref(n_busy))
+        if status == PLAN_STATUS_BASE + 4:  # capacité insuffisante : taille requise connue, on relance
+            cap_ev, cap_busy = n_ev.value, n_busy.value
+            continue
+        if status != 0:
+            raise ValueError(f"planification des descentes refusée (statut {status})")
+        break
+    else:  # pragma: no cover
+        raise RuntimeError("capacité de planification non stabilisée")
+    events = []
+    for k in range(n_ev.value):
+        e = evs[k]
+        hops = []
+        for h in range(e.hop_count):
+            c = e.hops[h]
+            if c.dir == 0:
+                src, dst = f"dev:{e.device_index}", "gw:0"
+            elif c.dir == 1:
+                src, dst = "gw:0", "ns"
+            else:
+                src, dst = "gw:0", f"dev:{e.device_index}"
+            hops.append(HopEvent(src, dst, c.t_ns, c.freq_hz, None if c.dr < 0 else c.dr,
+                                 c.rssi_dbm if c.has_rssi else None, _OUTCOMES[c.outcome]))
+        events.append(ProtocolEvent(seq=k, t_ns=e.t_ns, kind=_KINDS[e.kind],
+                                    device_index=e.device_index, gateway_index=0,
+                                    hops=tuple(hops), outcome=_OUTCOMES[e.outcome]))
+    intervals = tuple((busy[k].start_ns, busy[k].end_ns) for k in range(n_busy.value))
+    return tuple(events), intervals
diff --git a/python/lsim/gateway_sensitivity.py b/python/lsim/gateway_sensitivity.py
new file mode 100644
index 0000000..450fd50
--- /dev/null
+++ b/python/lsim/gateway_sensitivity.py
@@ -0,0 +1,95 @@
+"""Modèle de sensibilité absolue de passerelle `sensibilite-par-sf-v2` (ABI v2).
+
+Seuils publiés en dBm, indexés par bande et SF. Le calcul n'utilise ni la référence SX1276 ni
+un décalage relatif : une paire SF/bande absente est refusée, jamais déduite. Le modèle est
+passerelle unique seulement. Il ne s'applique qu'à la configuration qui le sélectionne
+explicitement ; sans lui, le chemin ABI v1 reste utilisé.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from lsim._native import _CGatewayV2
+
+MODEL_ID = "sensibilite-par-sf-v2"
+MODEL_CODE = 1  # valeur de `sensitivity_model` dans lsim_gateway_v2
+BANDWIDTHS_HZ = (125_000, 250_000, 500_000)  # indices 0, 1, 2 dans la table C
+SF_MIN, SF_MAX = 5, 12
+DBM_MIN, DBM_MAX = -160.0, -60.0
+# SF5 (DR13) : seule région où l'usage est documenté (RP002-1.0.5, EU868).
+SF5_REGION = "EU868"
+
+
+class SensitivityError(ValueError):
+    """Entrée absente, invalide ou incompatible avec le modèle de sensibilité."""
+
+
+@dataclass(frozen=True)
+class AbsoluteSensitivity:
+    """Points publiés : tuples (bande en Hz, SF, dBm). Aucune valeur par défaut."""
+
+    points: tuple[tuple[int, int, float], ...]
+    source: str = ""
+    conditions: str = ""
+
+    def __post_init__(self) -> None:
+        seen: set[tuple[int, int]] = set()
+        for bw, sf, dbm in self.points:
+            if bw not in BANDWIDTHS_HZ:
+                raise SensitivityError(f"{MODEL_ID} : bande {bw} Hz non supportée")
+            if sf == 6:
+                raise SensitivityError(f"{MODEL_ID} : SF6 non modélisé (en-tête implicite seulement)")
+            if not SF_MIN <= sf <= SF_MAX:
+                raise SensitivityError(f"{MODEL_ID} : SF{sf} hors de {SF_MIN}..{SF_MAX}")
+            if not DBM_MIN <= dbm <= DBM_MAX:
+                raise SensitivityError(f"{MODEL_ID} : {dbm} dBm hors de [{DBM_MIN}, {DBM_MAX}]")
+            if (bw, sf) in seen:
+                raise SensitivityError(f"{MODEL_ID} : point SF{sf}/{bw} Hz en double")
+            seen.add((bw, sf))
+
+    def lookup(self, sf: int, bandwidth_hz: int) -> float:
+        """Seuil publié pour cette paire ; SensitivityError si elle est absente."""
+        for bw, s, dbm in self.points:
+            if bw == bandwidth_hz and s == sf:
+                return dbm
+        raise SensitivityError(
+            f"sensibilité absente pour SF{sf}/{bandwidth_hz // 1000} kHz dans le modèle {MODEL_ID}")
+
+    def to_c(self, gateway) -> _CGatewayV2:
+        """Structure `lsim_gateway_v2`. Refuse un décalage non nul : pas de conversion implicite."""
+        if gateway.rx_sensitivity_offset_db != 0.0:
+            raise SensitivityError(f"{MODEL_ID} : décalage non nul refusé (pas de conversion implicite)")
+        c = _CGatewayV2()
+        c.base.x_m = gateway.x_m
+        c.base.y_m = gateway.y_m
+        c.base.antenna_gain_dbi = gateway.antenna_gain_dbi
+        c.base.rx_sensitivity_offset_db = 0.0
+        c.sensitivity_model = MODEL_CODE
+        present = 0
+        for bw, sf, dbm in self.points:
+            b = BANDWIDTHS_HZ.index(bw)
+            present |= 1 << (b * 8 + (sf - SF_MIN))
+            c.sensitivity_dbm[b][sf - SF_MIN] = dbm
+        c.present = present
+        return c
+
+
+# Catalogue de profils de sensibilité absolue (valeurs publiées, indicatives).
+# SF6 volontairement absent : DR12 utilise la référence SX1276 (non absolue).
+SX1303_DATASHEET = AbsoluteSensitivity(
+    points=((125_000, 5, -121.0), (125_000, 7, -127.0), (125_000, 8, -129.0),
+            (125_000, 9, -132.5), (125_000, 10, -135.5), (125_000, 11, -138.0),
+            (125_000, 12, -141.0)),
+    source="Semtech SX1303 datasheet (SX1303_W_APP, V1.2), p. 14-15 : sensibilités à 125 kHz",
+    conditions=("PER 10 %, paquets de 12 octets, front-end SX1250, LNA 18 dB, NF 1,5 dB, "
+                "conditions nominales ; valeurs indicatives, non normatives LoRaWAN"),
+)
+CATALOG: dict[str, AbsoluteSensitivity] = {"sx1303-datasheet": SX1303_DATASHEET}
+
+
+def refuse_absolute(gateway, path: str) -> None:
+    """Refus explicite : le chemin `path` n'utilise pas la sensibilité absolue."""
+    if getattr(gateway, "absolute_sensitivity", None) is not None:
+        raise SensitivityError(
+            f"{MODEL_ID} : non supporté par {path} (trace v2 et boucle fermée seulement)")
diff --git a/python/lsim/mac_loop.py b/python/lsim/mac_loop.py
new file mode 100644
index 0000000..173fd26
--- /dev/null
+++ b/python/lsim/mac_loop.py
@@ -0,0 +1,192 @@
+"""Bloc `mac:` → boucle fermée (LinkADRReq et DutyCycleReq) : paramètres du moteur natif.
+
+Actif seulement si le scénario demande `link_adr` ou `duty_cycle_exponent`. Sans ces champs, les
+scénarios gardent le chemin existant (résultats et empreintes inchangés).
+
+Périmètre : passerelle unique, sans jointure. Les réservations MAC (LinkCheckReq, DeviceTimeReq,
+DevStatusAns) suivent le calendrier de `mac_plan` : octets dans l'airtime, réponses dans les
+descentes qui répondent aux uplinks reçus. Les combinaisons hors périmètre sont refusées
+explicitement.
+
+Règles de puissance et de duty cycle (voir docs/CLOSED_LOOP_PLAN.md, S2) :
+- index 0 = puissance configurée, plafonnée par la PIRE du plan (`regions.POWER_TABLES`) ; chaque
+  index retire le pas du plan ; les index réservés par le plan sont refusés par LinkADR ;
+- limite réglementaire par index = sous-bande la plus restrictive à la PIRE de cet index,
+  combinée au duty cycle du groupe (`min`). DutyCycleReq ne fait que la réduire ;
+- un plan sans table TXPower n'accepte pas LinkADR (aucune puissance inventée).
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any, Optional, Sequence
+
+from lsim import mac_plan
+from lsim.closed_loop import (
+    ANSWER_DEVICE_STATUS, MAC_DEVICE_STATUS, MAC_DEVICE_TIME, MAC_LINK_CHECK, LoopOptions,
+    LoopRegion, MacByteAccounting, MacSlot,
+)
+from lsim.mac import DeviceTimeReq, LinkCheckReq
+from lsim.mac_plan import MacSchedule
+from lsim.plan import get_plan
+from lsim.regions import PROFILES, power_table
+
+
+def closed_loop_applies(scenario) -> bool:
+    """Vrai si le bloc `mac:` demande LinkADR ou DutyCycle (boucle fermée)."""
+    m = scenario.model.mac
+    return m is not None and (m.link_adr or m.duty_cycle_exponent is not None)
+
+
+def check_closed_loop(scenario, options: Any) -> None:
+    """Refuse explicitement les combinaisons hors périmètre de la boucle fermée (ValueError)."""
+    if getattr(options, "join", False):
+        raise ValueError("LinkADR/DutyCycle : jointure non supportée par la boucle fermée")
+    if scenario.model.gateways is not None or scenario.model.mesh is not None:
+        raise ValueError("LinkADR/DutyCycle : passerelle unique uniquement "
+                         "(pas de « gateways » ni de mesh)")
+
+
+def mac_slots(schedule: Optional[MacSchedule], devices: Sequence) -> tuple[MacSlot, ...]:
+    """Calendrier MAC de la boucle fermée : une entrée par émission réservée ou portante.
+
+    Les octets réservés sont ceux de `mac_plan.reserved_extra_bytes` (même calendrier que le
+    chemin historique). Les drapeaux suivent les requêtes du calendrier : LinkCheckAns et
+    DeviceTimeAns répondent à un uplink reçu de rang demandé, DevStatusReq est due dans le
+    downlink répondant à l'uplink de rang indiqué.
+    """
+    if schedule is None:
+        return ()
+    out: list[MacSlot] = []
+    for i, d in enumerate(devices):
+        for rank in range(1, d.messages + 1):
+            extra = mac_plan.reserved_extra_bytes(schedule, rank)
+            requests = mac_plan.uplink_requests(schedule, rank)
+            flags = 0
+            if LinkCheckReq() in requests:
+                flags |= MAC_LINK_CHECK
+            if DeviceTimeReq() in requests:
+                flags |= MAC_DEVICE_TIME
+            if mac_plan.device_status_request_due(schedule, rank):
+                flags |= MAC_DEVICE_STATUS
+            if extra or flags:
+                out.append(MacSlot(device=i, rank=rank, extra_bytes=extra, flags=flags))
+    return tuple(out)
+
+
+def loop_options(scenario, options: Any) -> LoopOptions:
+    m = scenario.model.mac
+    return LoopOptions(
+        confirmed_uplinks=options.confirmed_uplinks,
+        downlink_every=options.downlink_every,
+        downlink_payload_bytes=options.downlink_payload_bytes,
+        gateway_tx_power_dbm=options.gateway_tx_power_dbm,
+        device_antenna_gain_dbi=options.device_antenna_gain_dbi,
+        device_rx_offset_db=options.device_rx_offset_db,
+        adr=m.link_adr,
+        installation_margin_tenth_db=m.link_margin_installation_db * 10,
+        duty_cycle=m.duty_cycle_exponent is not None,
+        duty_cycle_exponent=m.duty_cycle_exponent or 0,
+    )
+
+
+def _group_region(g, link_adr: bool) -> LoopRegion:
+    """Paramètres régionaux d'un groupe (partagés par tous ses dispositifs)."""
+    tx = g.tx_power_dbm
+    if g.region is None:
+        if link_adr:
+            raise ValueError(f"groupe {g.name!r} : LinkADR exige un plan régional")
+        return LoopRegion(dr_sf=(0,) * 16, max_dr=0, max_tx_power_index=0,
+                          power_step_tenth_db=20, max_eirp_dbm=math.inf,
+                          duty_limit=(g.duty_cycle,) + (1.0,) * 15)
+
+    try:
+        plan = get_plan(g.region)
+    except ValueError as exc:
+        raise ValueError(f"groupe {g.name!r} : {exc}") from exc
+    dr_sf = [0] * 16
+    for i, (sf, bw_khz, _) in enumerate(plan.dr_table()[:16]):
+        if bw_khz == 125:
+            dr_sf[i] = sf
+    usable = [i for i, s in enumerate(dr_sf) if s]
+    max_dr = max(usable) if usable else 0
+    if link_adr and g.spreading_factor not in dr_sf:
+        raise ValueError(f"groupe {g.name!r} : SF {g.spreading_factor} absent des débits 125 kHz "
+                         f"du plan {g.region}")
+
+    table = power_table(g.region)
+    if link_adr and table is None:
+        raise ValueError(f"groupe {g.name!r} : plan {g.region} sans table TXPower, LinkADR refusé")
+    if table is not None and tx > table.max_eirp_dbm:
+        raise ValueError(f"groupe {g.name!r} : puissance {tx} dBm au-dessus de la PIRE du plan "
+                         f"({table.max_eirp_dbm} dBm)")
+    max_eirp = table.max_eirp_dbm if table is not None else math.inf
+    step_db = table.step_db if table is not None else 2.0
+    max_index = table.max_index if table is not None else 0
+    profile = PROFILES.get(g.region)
+    duty = [1.0] * 16
+    for i in range(max_index + 1):
+        eirp = min(tx, max_eirp) - i * step_db
+        limit = profile.duty_cycle_limit(g.channel_freq_hz, eirp) if profile is not None else None
+        duty[i] = g.duty_cycle if limit is None else min(g.duty_cycle, limit)
+    return LoopRegion(dr_sf=tuple(dr_sf), max_dr=max_dr, max_tx_power_index=max_index,
+                      power_step_tenth_db=round(step_db * 10),
+                      max_eirp_dbm=max_eirp, duty_limit=tuple(duty))
+
+
+# Tailles des réponses portées par un uplink (identiques à `answer_octets` du moteur).
+LINK_ADR_ANS_BYTES = 2
+DUTY_CYCLE_ANS_BYTES = 1
+
+
+def mac_byte_accounting(schedule: Optional[MacSchedule], devices: Sequence,
+                        uplinks: Sequence) -> MacByteAccounting:
+    """Comptabilité des octets MAC d'une boucle fermée (voir `MacByteAccounting`).
+
+    `uplinks` : `LoopOutcome.uplinks`, dans l'ordre temporel (rang = ordre par dispositif).
+    """
+    if schedule is None:
+        return MacByteAccounting(0, 0, 0, 0, 0, 0)
+    reserved = 0
+    reserved_ds = 0
+    for d in devices:
+        for rank in range(1, d.messages + 1):
+            reserved += mac_plan.reserved_extra_bytes(schedule, rank)
+            if rank >= 2 and mac_plan.device_status_request_due(schedule, rank - 1):
+                reserved_ds += mac_plan.DEVICE_STATUS_ANS_BYTES
+    sent = 0
+    sent_ds = 0
+    confirmed = 0
+    rank_of: dict[int, int] = {}
+    for u in uplinks:
+        rank = rank_of.get(u.device, 0) + 1
+        rank_of[u.device] = rank
+        if u.answer_mask & 1:
+            sent += LINK_ADR_ANS_BYTES
+        if u.answer_mask & 2:
+            sent += DUTY_CYCLE_ANS_BYTES
+        for cmd in mac_plan.uplink_requests(schedule, rank):
+            sent += (mac_plan.LINK_CHECK_REQ_BYTES if isinstance(cmd, LinkCheckReq)
+                     else mac_plan.DEVICE_TIME_REQ_BYTES)
+        if u.answer_mask & ANSWER_DEVICE_STATUS:
+            sent += mac_plan.DEVICE_STATUS_ANS_BYTES
+            sent_ds += mac_plan.DEVICE_STATUS_ANS_BYTES
+            if u.outcome == "received":
+                confirmed += 1
+    return MacByteAccounting(
+        reserved_bytes=reserved, reserved_ds_bytes=reserved_ds, sent_bytes=sent,
+        sent_ds_bytes=sent_ds, unused_reserved_ds_bytes=reserved_ds - sent_ds,
+        confirmed_ds_answers=confirmed)
+
+
+def loop_regions(scenario, group_of: Sequence[str]) -> list[LoopRegion]:
+    """Un `LoopRegion` par dispositif, dans l'ordre de `Scenario.deploy`."""
+    link_adr = scenario.model.mac.link_adr
+    by_name = {g.name: g for g in scenario.model.groups}
+    cache: dict[str, LoopRegion] = {}
+    out = []
+    for name in group_of:
+        if name not in cache:
+            cache[name] = _group_region(by_name[name], link_adr)
+        out.append(cache[name])
+    return out
