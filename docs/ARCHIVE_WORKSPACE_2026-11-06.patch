+// Octets MAC portés par un uplink : LinkADRAns (2), DutyCycleAns (1).
+std::uint32_t answer_octets(std::uint8_t mask) {
+    return static_cast<std::uint32_t>(((mask & 1U) != 0 ? 2U : 0U) + ((mask & 2U) != 0 ? 1U : 0U));
+}
