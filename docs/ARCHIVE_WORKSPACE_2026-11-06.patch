+// Régime de perte par sensibilité (110 dB de marge du terminal) : toute descente non reçue est
+// attribuée à BelowSensitivity, aucune à un autre motif, et aucune réponse n'est appliquée.
+void test_loss_below_sensitivity_exact_cause() {
+    LoopChannelConfig cfg = cfg_all_dr();
+    LoopChannelIo io;
+    io.trace_v3 = true;
+    LoopResult res;
+    SimulationStats tot;
+    DeviceStats st[1];
+    CHECK_EQ(static_cast<int>(run_channels_gw(&cfg, io, res, tot, st, 240, 10.0, 0.0, 110.0)), 0);
+    std::size_t lost = 0, applies = 0;
+    for (const LoopDownlink& d : res.downlinks) {
+        if (d.delivered) continue;
+        ++lost;
+        CHECK_TRUE(d.start_ns >= 0);       // créneau passerelle présent : la perte n'est pas NoGatewaySlot
+        CHECK_TRUE(!d.device_missed);      // le terminal n'émet pas pendant la RX1
+    }
+    for (const LoopTraceEvent& e : io.trace) {
+        if (e.kind == LoopTraceKind::Downlink && !e.flag) {
+            CHECK_EQ(static_cast<int>(e.loss), static_cast<int>(LoopDownlinkLoss::BelowSensitivity));
+        }
+        if (e.kind == LoopTraceKind::Apply) ++applies;
+    }
+    CHECK_TRUE(lost > 0);
+    CHECK_EQ(static_cast<int>(applies), 0);
+}
