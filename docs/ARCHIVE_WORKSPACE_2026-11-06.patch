+                //    exclu. Sur-approximation : un suspect peut être valide. Ce n'est pas une règle
+                //    TS001 ; c'est la seule attribution possible sans motif par canal.
+                const auto post = [&](LoopExclusionTarget target, std::uint16_t value, bool renewed) -> void {
+                    LoopTraceEvent e;
+                    e.t_ns = ta.end;
+                    e.device = d;
+                    e.uplink = static_cast<std::uint32_t>(a);
+                    e.kind = LoopTraceKind::Exclusion;
+                    e.origin = LoopTraceOrigin::SimulatorPolicy;
+                    e.action = renewed ? LoopTraceAction::Renewed : LoopTraceAction::Created;
+                    e.target = target;
+                    e.value = value;
+                    emit(e);
+                };
+                if ((st & 2U) == 0) post(LoopExclusionTarget::DataRate, req_dr, sv.excl.exclude_dr(req_dr));
+                if ((st & 4U) == 0) post(LoopExclusionTarget::Power, req_pw, sv.excl.exclude_power(req_pw));
+                if ((st & 1U) == 0 && (st & 2U) != 0) {
+                    // Masque refusé alors que le débit est accepté (D5 : un débit refusé est attribué au
+                    // débit, et les canaux ne sont pas suspects). Suspects = demandés et non confirmés.
+                    const LoopChannelSet req_set = set_from_block0(req_chmask);
+                    LoopChannelSet suspects;
+                    for (std::size_t c = 0; c < 16U; ++c) {
+                        if (req_set.test(c) && !sv.confirmed.test(c)) suspects.set(c);
+                    }
+                    if (!suspects.any()) {
+                        // Aucun suspect : exclusion du masque demandé complet (politique du simulateur).
+                        post(LoopExclusionTarget::Mask, req_chmask, sv.excl.exclude_mask(req_chmask));
+                    } else {
+                        for (std::size_t c = 0; c < 16U; ++c) {
+                            if (suspects.test(c)) {
+                                post(LoopExclusionTarget::Channel, static_cast<std::uint16_t>(c),
+                                     sv.excl.exclude_channel(c));
+                            }
+                        }
+                    }
+                }
+            }
+            sv.adr_pending = false;
+        }
+        if ((mask & 2U) != 0 && sv.duty_state == 1) sv.duty_state = 2;
+
+        if (options.adr) {
+            const LoopRegion& rg = regions[d];
+            const double snr = std::clamp(ta.rssi_dbm - kNoiseFloorDbmBw125, -kMaxLoopSnrDb, kMaxLoopSnrDb);
+            sv.snr.push_back(static_cast<std::int32_t>(std::lround(snr * 10.0)));
+            if (sv.snr.size() > kLoopHistory) sv.snr.erase(sv.snr.begin());
+            if (sv.snr.size() == kLoopHistory && !sv.adr_pending) {
+                lorawan::adr::Input in{};
+                for (std::size_t k = 0; k < sv.snr.size(); ++k) in.snr_tenth_db[k] = sv.snr[k];
+                in.n_samples = sv.snr.size();
+                in.dr = sv.dr;
+                in.dr_sf = rg.dr_sf;
+                in.min_dr = 0;
+                in.max_dr = rg.max_dr;
+                in.tx_power_index = sv.power_index;
+                in.max_tx_power_index = rg.max_tx_power_index;
+                in.power_step_tenth_db = rg.power_step_tenth_db;
+                in.installation_margin_tenth_db = options.installation_margin_tenth_db;
