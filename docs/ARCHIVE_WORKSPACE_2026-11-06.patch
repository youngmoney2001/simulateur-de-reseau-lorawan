+    DeviceStats st[2];
+    SimulationStats tot;
+    LoopResult res;
+    LoopOptions opt;
+    const LoopMacSlot slots[] = {
+        {0, 1, 0, kLoopMacLinkCheck},
+        {1, 1, 0, kLoopMacLinkCheck},
+    };
