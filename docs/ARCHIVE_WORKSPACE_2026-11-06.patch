+void test_no_command_parity_with_causal() {
+    const EndDeviceSpec d[] = {dev(100.0, 7, 0, 30 * kS, 20), dev(2500.0, 9, 3 * kS, 30 * kS, 20),
+                               dev(900.0, 7, 7 * kS, 30 * kS, 20)};
+    lsim::plan::DeviceRadio rv[3] = {radio(), radio(), radio()};
