{
  "$defs": {
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "sensor",
            "relay",
            "border",
            "server"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "x_m": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Y M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "x_m",
        "y_m"
      ],
      "title": "Node",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exercise_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exercise Id"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 64,
      "title": "Nodes",
      "type": "array"
    }
  },
  "title": "SessionCreate",
  "type": "object"
}
