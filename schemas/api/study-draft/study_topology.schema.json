{
  "$defs": {
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "sensor",
            "relay",
            "border",
            "server"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "x_m": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Y M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "x_m",
        "y_m"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeState": {
      "additionalProperties": false,
      "description": "État résumé d'un équipement : jamais de clé réelle (`keys` ne vaut que « ****** »).",
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "hostname": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "keys": {
          "anyOf": [
            {
              "const": "******",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Node Id",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "node_id",
        "hostname",
        "configured"
      ],
      "title": "NodeState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 64,
      "title": "Nodes",
      "type": "array"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9_-]{8,64}$",
      "title": "Session Id",
      "type": "string"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/NodeState"
      },
      "maxItems": 64,
      "title": "States",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "nodes",
    "states"
  ],
  "title": "SessionTopology",
  "type": "object"
}
