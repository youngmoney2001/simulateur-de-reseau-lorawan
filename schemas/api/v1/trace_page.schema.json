{
  "$defs": {
    "Hop": {
      "additionalProperties": false,
      "description": "Un saut de la trame : émetteur -> récepteur, avec le résultat sur ce saut.",
      "properties": {
        "dr": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dr"
        },
        "freq_hz": {
          "exclusiveMinimum": 0,
          "title": "Freq Hz",
          "type": "integer"
        },
        "from_id": {
          "maxLength": 64,
          "title": "From Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "delivered",
            "lost_sensitivity",
            "lost_collision",
            "lost_half_duplex",
            "not_listened",
            "sent",
            "suppressed",
            "lost_mesh"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rssi_dbm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rssi Dbm"
        },
        "t_ns": {
          "minimum": 0,
          "title": "T Ns",
          "type": "integer"
        },
        "to_id": {
          "maxLength": 64,
          "title": "To Id",
          "type": "string"
        }
      },
      "required": [
        "from_id",
        "to_id",
        "t_ns",
        "freq_hz",
        "outcome"
      ],
      "title": "Hop",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "device_index": {
          "minimum": 0,
          "title": "Device Index",
          "type": "integer"
        },
        "gateway_index": {
          "default": 0,
          "minimum": 0,
          "title": "Gateway Index",
          "type": "integer"
        },
        "hops": {
          "items": {
            "$ref": "#/$defs/Hop"
          },
          "maxItems": 8,
          "title": "Hops",
          "type": "array"
        },
        "kind": {
          "enum": [
            "join_request",
            "join_accept",
            "uplink",
            "ack",
            "downlink",
            "lost_sensitivity",
            "lost_collision",
            "rx_window_missed",
            "mesh_hop",
            "mesh_downlink_hop",
            "mac_request",
            "mac_answer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "maxLength": 64,
          "title": "Outcome",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ns": {
          "minimum": 0,
          "title": "T Ns",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "t_ns",
        "kind",
        "device_index",
        "outcome"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "maxItems": 500,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "items"
  ],
  "title": "TracePage",
  "type": "object"
}
