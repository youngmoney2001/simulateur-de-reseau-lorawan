          "title": "Audible Frames",
          "type": "integer"
        },
        "busy_ns": {
          "minimum": 0,
          "title": "Busy Ns",
          "type": "integer"
        },
        "latency_p50_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency P50 Ms"
        },
        "latency_p95_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency P95 Ms"
        },
        "latency_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Samples",
          "type": "integer"
        },
        "lost_collision": {
          "minimum": 0,
          "title": "Lost Collision",
          "type": "integer"
        },
        "lost_gateway_busy": {
          "minimum": 0,
          "title": "Lost Gateway Busy",
          "type": "integer"
        },
        "lost_sensitivity": {
