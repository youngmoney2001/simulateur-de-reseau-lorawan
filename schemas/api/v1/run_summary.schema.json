  "additionalProperties": false,
  "description": "Résumé d'un run. Exactement un des deux champs : `gateway` (mono-passerelle, champ présent\ndepuis la v1) ou `gateways` (multi-passerelles, ajouté en v1 ; `gateway` est alors absent).",
  "properties": {
    "duty_cycle": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DutyCycleOut"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duty Cycle"
    },
    "energy_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Energy Profile"
    },
    "gateway": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayLoadOut"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gateways": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/GatewayReportOut"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gateways"
    },
    "pdr": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdr"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{8,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "rx_matrix": {
      "anyOf": [
        {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rx Matrix"
    },
    "scenario_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Sha256",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    }
  },
  "required": [
    "run_id",
    "scenario_sha256",
    "seed",
    "totals"
