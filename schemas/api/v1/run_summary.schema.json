          "minimum": 0,
          "title": "Delivered",
          "type": "integer"
        },
        "from_gateway": {
          "maxLength": 64,
          "title": "From Gateway",
          "type": "string"
        }
      },
      "required": [
        "from_gateway",
        "delivered"
      ],
      "title": "MeshInboundOut",
      "type": "object"
    },
    "Totals": {
