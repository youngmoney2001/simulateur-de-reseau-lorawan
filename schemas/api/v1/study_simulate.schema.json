{
  "$defs": {
    "GatewayLink": {
      "additionalProperties": false,
      "description": "Association explicite : un équipement de la session et une passerelle du run (par nom,\nunique dans le scénario). Un équipement ou une passerelle n'apparaît qu'une fois.",
      "properties": {
        "gateway": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Gateway",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "gateway"
      ],
      "title": "GatewayLink",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Run créé à partir de la session. `links` : liaisons à appliquer au résultat (une fois\nterminé) ; `notes` : défauts appliqués et réglages non modélisés.",
  "properties": {
    "links": {
      "items": {
        "$ref": "#/$defs/GatewayLink"
      },
      "maxItems": 64,
      "title": "Links",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Notes",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{8,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "state": {
      "maxLength": 16,
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "state",
    "links",
    "notes"
  ],
  "title": "SimulateOut",
  "type": "object"
}
