{
  "$defs": {
    "SessionSummary": {
      "additionalProperties": false,
      "properties": {
        "exercise_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Id"
        },
        "idle_s": {
          "minimum": 0,
          "title": "Idle S",
          "type": "integer"
        },
        "nodes": {
          "maximum": 64,
          "minimum": 0,
          "title": "Nodes",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "nodes",
        "idle_s"
      ],
      "title": "SessionSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/SessionSummary"
      },
      "maxItems": 8,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "SessionList",
  "type": "object"
}
